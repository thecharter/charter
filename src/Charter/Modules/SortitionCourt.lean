  panelSize             : Nat  := 3
  maxAppealTiers        : Nat  := 3
  appealTierDeadline    : Time := 10
  operatingReserveFloor : Nat  := 100
  minServiceBudget      : Nat  := 50
  instantiationLevyCap  : Nat  := 2
  deriving DecidableEq, Repr, Inhabited

