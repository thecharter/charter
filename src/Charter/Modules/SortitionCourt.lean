/-- Maximum total duration of an adjudication proceeding across `maxTiers` tiers,
each deciding within `tierDeadline`. -/
def totalAdjudicationBound (maxTiers tierDeadline : Nat) : Nat :=
  maxTiers * tierDeadline

/-- State of a tiered sortition proceeding. -/
structure ProceedingState where
  currentTier  : Nat
  maxTiers     : Nat
  tierDeadline : Nat
  elapsedTime  : Nat
  finalized    : Bool
  deriving DecidableEq, Repr

/-- Advancing a proceeding by one tier decision (taking `dt ≤ tierDeadline` time)
and either appealing to the next tier (if `appealRequested` and `currentTier + 1 < maxTiers`)
or reaching a final ruling (`finalized = true`). -/
def stepProceeding (st : ProceedingState) (dt : Nat) (appealRequested : Bool) : ProceedingState :=
  if st.finalized then st
  else
    let dtCapped := min dt st.tierDeadline
    let nextTime := st.elapsedTime + dtCapped
    if appealRequested && decide (st.currentTier + 1 < st.maxTiers) then
      { st with currentTier := st.currentTier + 1, elapsedTime := nextTime }
    else
      { st with elapsedTime := nextTime, finalized := true }

/-- Initial proceeding state at tier `0` with `elapsedTime = 0` and `finalized = false`. -/
def initProceeding (maxTiers tierDeadline : Nat) : ProceedingState :=
  { currentTier  := 0
    maxTiers     := maxTiers
    tierDeadline := tierDeadline
    elapsedTime  := 0
    finalized    := false }

/-- Multi-step execution of a proceeding across a sequence of tier decisions
`(dt, appealRequested)`. -/
def runProceeding (st : ProceedingState) : List (Nat × Bool) → ProceedingState
  | [] => st
  | (dt, appeal) :: rest => runProceeding (stepProceeding st dt appeal) rest

/-- Result of allocating a fee pool across the non-divertible operating reserve
and the 5 ranked protected charges. -/
structure FeePoolAllocation where
  operatingReserveFunded : Nat
  rank1FinalHearingMinCh : Nat
  rank2ColdStorage       : Nat
  rank3TestimonyVoice    : Nat
  rank4ArbiterGuarantee  : Nat
  rank5AdvocacyFunding   : Nat
  unspentPoolSurplus     : Nat
  deriving DecidableEq, Repr

/-- Strict priority waterfall allocation of `poolBalance`:
0. Non-divertible operating reserve `operatingReserve` is funded first.
1. Reserved final hearings and minimal channels for suspended members (`r1`).
2. Cold storage for suspended members (`r2`).
3. Testimony screening and inscription (`r3`).
4. Arbiter fee guarantees (`r4`).
5. Capped advocacy funding (`r5`). -/
def allocateFeePool (poolBalance operatingReserve r1 r2 r3 r4 r5 : Nat) : FeePoolAllocation :=
  let op := min poolBalance operatingReserve
  let rem0 := poolBalance - op
  let p1 := min rem0 r1
  let rem1 := rem0 - p1
  let p2 := min rem1 r2
  let rem2 := rem1 - p2
  let p3 := min rem2 r3
  let rem3 := rem2 - p3
  let p4 := min rem3 r4
  let rem4 := rem3 - p4
  let p5 := min rem4 r5
  let rem5 := rem4 - p5
  { operatingReserveFunded := op
    rank1FinalHearingMinCh := p1
    rank2ColdStorage       := p2
    rank3TestimonyVoice    := p3
    rank4ArbiterGuarantee  := p4
    rank5AdvocacyFunding   := p5
    unspentPoolSurplus     := rem5 }

/-- Per-group service budget: equals the greater of the group's protected
minimum budget `minBudget` fixed at instantiation and the fee-pool revenue
`feeRevenueGenerated` generated by its members, completely independent of
`_memberCount`. -/
def groupServiceBudget (minBudget feeRevenueGenerated _memberCount : Nat) : Nat :=
  max minBudget feeRevenueGenerated

/-- Excess subsidy claim by a group: given `memberCount` members each demanding
`perMemberDemand` of subsidized rights after exhausting `totalLifecycleReserves`,
the claim covered is capped by `groupServiceBudget minBudget feeRevenueGenerated memberCount`;
any excess demand receives `0` from the fee pool. -/
def settleGroupSubsidyDemand (minBudget feeRevenueGenerated memberCount
    perMemberDemand totalLifecycleReserves : Nat) : Nat × Nat × Nat :=
  let totalDemand := memberCount * perMemberDemand
  let fromLifecycle := min totalDemand totalLifecycleReserves
  let remDemand := totalDemand - fromLifecycle
  let budget := groupServiceBudget minBudget feeRevenueGenerated memberCount
  let fromGroupBudget := min remDemand budget
  let extraPoolClaim := 0
  (fromLifecycle, fromGroupBudget, extraPoolClaim)

/-- Shared-infrastructure governance validity check: valid only if `newLevy`
does not exceed `instantiationLevyCap`, `newMinBudget` is at least
`instantiationMinBudget`, anti-capture guarantees remain intact, insolvency
termination is not broadened, and the panel is not setting admission criteria
for its own members' affiliates. -/
def validSharedInfraChange (instantiationLevyCap newLevy instantiationMinBudget newMinBudget : Nat)
    (antiCaptureIntact insolvencyUnbroadened noSelfAffiliateAdmission : Bool) : Bool :=
  decide (newLevy ≤ instantiationLevyCap ∧ instantiationMinBudget ≤ newMinBudget) &&
    antiCaptureIntact && insolvencyUnbroadened && noSelfAffiliateAdmission

/-- A dispute filing submitted to adjudication. -/
structure DisputeFiling where
  filingId      : Nat
  filerId       : Nat
  factPatternId : Nat
  counterStake  : Nat
  feeCap        : Nat
  deriving DecidableEq, Repr, Inhabited

/-- Consolidation of repeated proceedings by related parties on substantially
similar grounds: merges `incoming` into `existing` (keeping the single
`existing.counterStake` and `existing.feeCap`) whenever
`existing.factPatternId == incoming.factPatternId && isRelatedFn existing.filerId incoming.filerId`. -/
def consolidateRelatedFilings (isRelatedFn : Nat → Nat → Bool)
    (existing : DisputeFiling) (incoming : DisputeFiling) : Option DisputeFiling :=
  if (existing.factPatternId == incoming.factPatternId) &&
     isRelatedFn existing.filerId incoming.filerId then
    some existing
  else
    none

/-! ## 2. Parametric Normative Rule Builders over Any Signature `σ : Sig` -/

/-- Build an arbiter recusal & diversity duty over any signature `σ`. -/
def mkDutyArbiterRecusalAndDiversity {σ : Sig} (id : String) (sp : Span)
    (beneficiaries : List σ.Actor) (boundFact : σ.Fact) (seatConflictedAct : σ.Act) : Duty σ :=
  { id := id
    source := sp
    bearer := .anyone
    beneficiary := .only beneficiaries
    active := .holds boundFact
    demand := .forbid (.act seatConflictedAct) }

/-- Build a finality bar on repeat proceedings over any signature `σ`. -/
def mkDutyFinalityNoRepeat {σ : Sig} (id : String) (sp : Span)
    (beneficiaries : List σ.Actor)
    (boundFact finalFact newEvidenceFact : σ.Fact) (repeatFilingAct : σ.Act) : Duty σ :=
  { id := id
    source := sp
    bearer := .anyone
    beneficiary := .only beneficiaries
    active := .and (.holds boundFact) (.holds finalFact)
    demand := .forbid (.act repeatFilingAct)
    unlessCond := .holds newEvidenceFact }

/-- Build a prohibition on contingent arbiter fees over any signature `σ`. -/
def mkDutyNoContingentFees {σ : Sig} (id : String) (sp : Span)
    (beneficiaries : List σ.Actor) (boundFact : σ.Fact) (contingentFeeAct : σ.Act) : Duty σ :=
  { id := id
    source := sp
    bearer := .anyone
    beneficiary := .only beneficiaries
    active := .holds boundFact
    demand := .forbid (.act contingentFeeAct) }

/-- Build a sortition panel drawing power over any signature `σ`. -/
def mkPowerDrawSortitionPanel {σ : Sig} (id : String) (sp : Span)
    (holders : List σ.Actor) (triggerAct : σ.Act)
    (boundFact panelDrawnFact bondsPostedFact : σ.Fact) : Power σ :=
  { id := id
    source := sp
    holder := .only holders
    trigger := .act triggerAct
    valid := .holds boundFact
    adds := [panelDrawnFact, bondsPostedFact] }

/-- Build an appeal power over any signature `σ`. -/
def mkPowerAppealRuling {σ : Sig} (id : String) (sp : Span)
    (holders : List σ.Actor) (triggerAct : σ.Act)
    (boundFact finalFact appealedFact bondPostedFact : σ.Fact) : Power σ :=
  { id := id
    source := sp
    holder := .only holders
    trigger := .act triggerAct
    valid := .and (.holds boundFact) (.not (.holds finalFact))
    adds := [appealedFact, bondPostedFact] }

/-- Build a ruling finalization power over any signature `σ`. -/
def mkPowerFinalizeRuling {σ : Sig} (id : String) (sp : Span)
    (holders : List σ.Actor) (triggerAct : σ.Act)
    (boundFact finalFact appealedFact : σ.Fact) : Power σ :=
  { id := id
    source := sp
    holder := .only holders
    trigger := .act triggerAct
    valid := .holds boundFact
    adds := [finalFact]
    removes := [appealedFact] }

/-- Build a fee-pool waterfall allocation power over any signature `σ`. -/
def mkPowerAllocateFeePool {σ : Sig} (id : String) (sp : Span)
    (holders : List σ.Actor) (triggerAct : σ.Act)
    (boundFact reserveMaintainedFact poolAllocatedFact : σ.Fact) : Power σ :=
  { id := id
    source := sp
    holder := .only holders
    trigger := .act triggerAct
    valid := .holds boundFact
    adds := [reserveMaintainedFact, poolAllocatedFact] }

/-! ## 3. Module-Level Invariant Theorems -/

/-- Sybil-resistant sortition guarantees independence, minimum bond, panel-size
cap, and at most one seat per `sybilClusterId`. -/
theorem sortition_court_sybil_resistant_panel_properties
    (minBond sz clusterId : Nat) (cs : List ArbiterCandidate) :
    (∀ c ∈ selectSybilResistantPanel minBond sz cs,
      c.relatedToDispute = false ∧ c.bond ≥ minBond) ∧
    (selectSybilResistantPanel minBond sz cs).length ≤ sz ∧
    ((selectSybilResistantPanel minBond sz cs).filter
      (fun c => c.sybilClusterId == clusterId)).length ≤ 1 :=
  sortition_sybil_resistant_panel_properties minBond sz clusterId cs

/-- Related-party filing consolidation preserves the single existing
`counterStake` and `feeCap`, preventing litigation DoS from multiplying fees. -/
theorem sortition_court_consolidate_preserves_cap
    (isRel : Nat → Nat → Bool) (existing incoming merged : DisputeFiling)
    (h : consolidateRelatedFilings isRel existing incoming = some merged) :
    merged = existing ∧
    merged.counterStake = existing.counterStake ∧
    merged.feeCap = existing.feeCap := by
  unfold consolidateRelatedFilings at h
  split at h
  · injection h with hEq
    subst hEq
    exact ⟨rfl, rfl, rfl⟩
  · contradiction

/-- Each step of a tiered sortition proceeding increases `elapsedTime` by at
most `st.tierDeadline` (and leaves `elapsedTime` unchanged once finalized). -/
theorem sortition_court_step_proceeding_bounded
    (st : ProceedingState) (dt : Nat) (appeal : Bool) :
    (stepProceeding st dt appeal).elapsedTime ≤ st.elapsedTime + st.tierDeadline ∧
    (st.finalized = true → stepProceeding st dt appeal = st) := by
  refine ⟨?_, fun hFin => by simp [stepProceeding, hFin]⟩
  unfold stepProceeding
  have hMin : min dt st.tierDeadline ≤ st.tierDeadline := Nat.min_le_right _ _
  split
  · omega
  · split <;> dsimp <;> omega

theorem runProceeding_finalized (st : ProceedingState) (steps : List (Nat × Bool))
    (hf : st.finalized = true) :
    runProceeding st steps = st := by
  induction steps generalizing st with
  | nil => rfl
  | cons hd tl ih =>
    rcases hd with ⟨dt, app⟩
    have hStep : stepProceeding st dt app = st := by simp [stepProceeding, hf]
    simp [runProceeding, hStep, ih st hf]

theorem runProceeding_bound (st : ProceedingState) (steps : List (Nat × Bool)) :
    (st.finalized = true →
      (runProceeding st steps).elapsedTime = st.elapsedTime ∧
      (runProceeding st steps).finalized = true) ∧
    (st.finalized = false → st.currentTier < st.maxTiers →
      (runProceeding st steps).elapsedTime ≤
        st.elapsedTime + (st.maxTiers - st.currentTier) * st.tierDeadline ∧
      (st.maxTiers - st.currentTier ≤ steps.length →
        (runProceeding st steps).finalized = true)) := by
  induction steps generalizing st with
  | nil =>
    dsimp [runProceeding]
    refine ⟨fun hf => ⟨rfl, hf⟩, fun hnf hlt => ⟨by omega, fun hlen => by simp at hlen; omega⟩⟩
  | cons hd tl ih =>
    rcases hd with ⟨dt, app⟩
    refine ⟨fun hf => ?_, fun hnf hlt => ?_⟩
    · rw [runProceeding_finalized st ((dt, app) :: tl) hf]
      exact ⟨rfl, hf⟩
    · simp only [runProceeding, stepProceeding, hnf, Bool.false_eq_true, ↓reduceIte]
      have hCap : min dt st.tierDeadline ≤ st.tierDeadline := Nat.min_le_right dt st.tierDeadline
      split
      · rename_i hApp
        simp only [Bool.and_eq_true, decide_eq_true_eq] at hApp
        have ihNext := (ih { st with currentTier := st.currentTier + 1, elapsedTime := st.elapsedTime + min dt st.tierDeadline, finalized := false }).2 rfl hApp.2
        dsimp only at ihNext
        have hSub : st.maxTiers - st.currentTier = (st.maxTiers - (st.currentTier + 1)) + 1 := by omega
        have hMul : (st.maxTiers - st.currentTier) * st.tierDeadline =
            (st.maxTiers - (st.currentTier + 1)) * st.tierDeadline + st.tierDeadline := by
          rw [hSub, Nat.add_one_mul]
        refine ⟨?_, ?_⟩
        · have hEl := ihNext.1
          omega
        · intro hlen
          simp only [List.length_cons] at hlen
          exact ihNext.2 (by omega)
      · have ihFin := (ih { st with elapsedTime := st.elapsedTime + min dt st.tierDeadline, finalized := true }).1 rfl
        dsimp only at ihFin
        have hGe1 : 1 ≤ st.maxTiers - st.currentTier := by omega
        have hDeadlineLe : st.tierDeadline ≤ (st.maxTiers - st.currentTier) * st.tierDeadline := by
          simpa using Nat.mul_le_mul_right st.tierDeadline hGe1
        refine ⟨?_, fun _ => ihFin.2⟩
        have hEl := ihFin.1
        omega

/-- Strict 5-rank priority waterfall (`allocateFeePool`) funds the
non-divertible operating reserve first (`min poolBalance operatingReserve`) and
conserves 100% of `poolBalance` across the reserve, 5 ranked charges, and surplus. -/
theorem sortition_court_fee_pool_conserves_balance
    (poolBalance operatingReserve r1 r2 r3 r4 r5 : Nat) :
    let wf := allocateFeePool poolBalance operatingReserve r1 r2 r3 r4 r5
    wf.operatingReserveFunded = min poolBalance operatingReserve ∧
    wf.operatingReserveFunded + wf.rank1FinalHearingMinCh + wf.rank2ColdStorage +
      wf.rank3TestimonyVoice + wf.rank4ArbiterGuarantee + wf.rank5AdvocacyFunding +
      wf.unspentPoolSurplus = poolBalance := by
  dsimp [allocateFeePool]
  have h0 : min poolBalance operatingReserve ≤ poolBalance := Nat.min_le_left _ _
  have h1 : min (poolBalance - min poolBalance operatingReserve) r1 ≤
      poolBalance - min poolBalance operatingReserve := Nat.min_le_left _ _
  have h2 : min (poolBalance - min poolBalance operatingReserve -
      min (poolBalance - min poolBalance operatingReserve) r1) r2 ≤
      poolBalance - min poolBalance operatingReserve -
      min (poolBalance - min poolBalance operatingReserve) r1 := Nat.min_le_left _ _
  have h3 : min (poolBalance - min poolBalance operatingReserve -
      min (poolBalance - min poolBalance operatingReserve) r1 -
      min (poolBalance - min poolBalance operatingReserve -
        min (poolBalance - min poolBalance operatingReserve) r1) r2) r3 ≤
      poolBalance - min poolBalance operatingReserve -
      min (poolBalance - min poolBalance operatingReserve) r1 -
      min (poolBalance - min poolBalance operatingReserve -
        min (poolBalance - min poolBalance operatingReserve) r1) r2 := Nat.min_le_left _ _
  have h4 : min (poolBalance - min poolBalance operatingReserve -
      min (poolBalance - min poolBalance operatingReserve) r1 -
      min (poolBalance - min poolBalance operatingReserve -
        min (poolBalance - min poolBalance operatingReserve) r1) r2 -
      min (poolBalance - min poolBalance operatingReserve -
        min (poolBalance - min poolBalance operatingReserve) r1 -
        min (poolBalance - min poolBalance operatingReserve -
          min (poolBalance - min poolBalance operatingReserve) r1) r2) r3) r4 ≤
      poolBalance - min poolBalance operatingReserve -
      min (poolBalance - min poolBalance operatingReserve) r1 -
      min (poolBalance - min poolBalance operatingReserve -
        min (poolBalance - min poolBalance operatingReserve) r1) r2 -
      min (poolBalance - min poolBalance operatingReserve -
        min (poolBalance - min poolBalance operatingReserve) r1 -
        min (poolBalance - min poolBalance operatingReserve -
          min (poolBalance - min poolBalance operatingReserve) r1) r2) r3 := Nat.min_le_left _ _
  have h5 : min (poolBalance - min poolBalance operatingReserve -
      min (poolBalance - min poolBalance operatingReserve) r1 -
      min (poolBalance - min poolBalance operatingReserve -
        min (poolBalance - min poolBalance operatingReserve) r1) r2 -
      min (poolBalance - min poolBalance operatingReserve -
        min (poolBalance - min poolBalance operatingReserve) r1 -
        min (poolBalance - min poolBalance operatingReserve -
          min (poolBalance - min poolBalance operatingReserve) r1) r2) r3 -
      min (poolBalance - min poolBalance operatingReserve -
        min (poolBalance - min poolBalance operatingReserve) r1 -
        min (poolBalance - min poolBalance operatingReserve -
          min (poolBalance - min poolBalance operatingReserve) r1) r2 -
        min (poolBalance - min poolBalance operatingReserve -
          min (poolBalance - min poolBalance operatingReserve) r1 -
          min (poolBalance - min poolBalance operatingReserve -
            min (poolBalance - min poolBalance operatingReserve) r1) r2) r3) r4) r5 ≤
      poolBalance - min poolBalance operatingReserve -
      min (poolBalance - min poolBalance operatingReserve) r1 -
      min (poolBalance - min poolBalance operatingReserve -
        min (poolBalance - min poolBalance operatingReserve) r1) r2 -
      min (poolBalance - min poolBalance operatingReserve -
        min (poolBalance - min poolBalance operatingReserve) r1 -
        min (poolBalance - min poolBalance operatingReserve -
          min (poolBalance - min poolBalance operatingReserve) r1) r2) r3 -
      min (poolBalance - min poolBalance operatingReserve -
        min (poolBalance - min poolBalance operatingReserve) r1 -
        min (poolBalance - min poolBalance operatingReserve -
          min (poolBalance - min poolBalance operatingReserve) r1) r2 -
        min (poolBalance - min poolBalance operatingReserve -
          min (poolBalance - min poolBalance operatingReserve) r1 -
          min (poolBalance - min poolBalance operatingReserve -
            min (poolBalance - min poolBalance operatingReserve) r1) r2) r3) r4 := Nat.min_le_left _ _
  exact ⟨rfl, by omega⟩

/-- Multi-step bounded adjudication finality: across any sequence of tier
decisions `steps : List (Nat × Bool)` starting from `initProceeding maxTiers tierDeadline`
(with `0 < maxTiers`), total elapsed time never exceeds
`totalAdjudicationBound maxTiers tierDeadline` (`maxTiers * tierDeadline`), and
whenever `maxTiers ≤ steps.length`, the proceeding reaches `finalized = true`. -/
theorem sortition_court_run_proceeding_bounded
    (maxTiers tierDeadline : Nat) (steps : List (Nat × Bool)) (hTiers : 0 < maxTiers) :
    (runProceeding (initProceeding maxTiers tierDeadline) steps).elapsedTime ≤
      totalAdjudicationBound maxTiers tierDeadline ∧
    (maxTiers ≤ steps.length →
      (runProceeding (initProceeding maxTiers tierDeadline) steps).finalized = true) := by
  have hRun := (runProceeding_bound (initProceeding maxTiers tierDeadline) steps).2 rfl hTiers
  dsimp [initProceeding, totalAdjudicationBound] at hRun ⊢
  exact ⟨by have := hRun.1; omega, fun hlen => hRun.2 (by omega)⟩

/-! ## 4. Parametric Module Self-Test -/

/-- Decidable self-test exercising `selectSybilResistantPanel`,
`supermajorityPassed`, `consolidateRelatedFilings`, `runProceeding`, and
`allocateFeePool`. -/
def sortitionCourtSelfTest : Bool :=
  let pool : List ArbiterCandidate :=
    [ ⟨1, 200, 10, true⟩,
      ⟨2, 50,  20, false⟩,
      ⟨3, 150, 30, false⟩,
      ⟨4, 180, 30, false⟩,
      ⟨5, 220, 40, false⟩,
      ⟨6, 160, 50, false⟩ ]
  let panel := selectSybilResistantPanel 100 3 pool
  let f1 : DisputeFiling := ⟨1, 10, 99, 50, 20⟩
  let f2 : DisputeFiling := ⟨2, 10, 99, 50, 20⟩
  let merged := consolidateRelatedFilings (fun a b => a == b) f1 f2
  let pFinal := runProceeding (initProceeding 3 10) [(8, true), (12, true), (9, true)]
  let wf := allocateFeePool 180 100 30 20 15 10 25
  (panel.map (·.arbiterId) == [3, 5, 6]) &&
  (!supermajorityPassed 1 3) &&
  supermajorityPassed 2 3 &&
  (merged == some f1) &&
  (pFinal.finalized && pFinal.currentTier == 2 && pFinal.elapsedTime == 27) &&
  (wf.operatingReserveFunded == 100 && wf.rank5AdvocacyFunding == 5 && wf.unspentPoolSurplus == 0)

theorem sortitionCourtSelfTest_passes : sortitionCourtSelfTest = true := by decide

