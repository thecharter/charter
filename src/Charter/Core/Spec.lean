import Charter.Core.Term
import Charter.Core.Defeasible
import Charter.Core.Provenance
import Charter.Core.Diagnostics

/-!
# Charter.Core.Spec — Type declarations as records

A program's declarations, as eFLINT 4.1 keeps them (`Spec.hs`), per D2: every
type (`Fact`, `Act`, `Duty`, `Event`) is a `TypeSpec` record with its domain, its
domain constraint (`Where`), its derivation rules (`Holds when`, `Derived from`),
its preconditions (`Conditioned by`), whether it is open or closed, and the data
of its kind (effects and syncs of acts and events, violation conditions of
duties). A `Spec` is the map of these records plus placeholder aliases.

Everything is data a projection can read without evaluating (Law 5). The
surface form of a declaration (`Decl`, `ModClause`) is here too, because the
resolver turns it into the same records by `applyTypeExt`.
-/

namespace Charter

/-- Fast syntactic check for the default unconstrained domain filter `.boolLit true`. -/
def _root_.Charter.Term.isTrueLit : Term → Bool
  | .boolLit true => true
  | _ => false

/-- Structural radix map keyed by `DomId`, for kernel-unfoldable indexed lookups in `Eval`. -/
inductive DomMap (α : Type) where
  | empty
  | leaf (entries : List (DomId × α))
  | branch (l r : DomMap α)
  deriving Repr, Inhabited

namespace DomMap

def hashChars : List Char → Nat → Nat
  | [], h => h
  | c :: cs, h => hashChars cs ((h * 5 + c.toNat) % 1024)

def hash (k : DomId) : Nat :=
  hashChars k.toList 7

def treeDepth : Nat := 8

def lookupAux {α} : Nat → Nat → DomMap α → DomId → Option α
  | _, _, .empty, _ => none
  | 0, _, .leaf es, k => (es.find? (·.1 == k)).map (·.2)
  | n + 1, h, .branch l r, k =>
    if h % 2 == 0 then lookupAux n (h / 2) l k else lookupAux n (h / 2) r k
  | _, _, _, _ => none

def lookup {α} (m : DomMap α) (k : DomId) : Option α :=
  lookupAux treeDepth (hash k) m k

def modifyAux {α} (f : Option α → α) : Nat → Nat → DomId → DomMap α → DomMap α
  | 0, _, k, .empty => .leaf [(k, f none)]
  | 0, _, k, .leaf es =>
    match es.find? (·.1 == k) with
    | some (_, v) => .leaf ((k, f (some v)) :: es.filter (·.1 != k))
    | none => .leaf ((k, f none) :: es)
  | n + 1, h, k, .empty =>
    if h % 2 == 0 then .branch (modifyAux f n (h / 2) k .empty) .empty
    else .branch .empty (modifyAux f n (h / 2) k .empty)
  | n + 1, h, k, .branch l r =>
    if h % 2 == 0 then .branch (modifyAux f n (h / 2) k l) r
    else .branch l (modifyAux f n (h / 2) k r)
  | _, _, _, m => m

def insert {α} (m : DomMap α) (k : DomId) (v : α) : DomMap α :=
  modifyAux (fun _ => v) treeDepth (hash k) k m

def prepend {β} (m : DomMap (List β)) (k : DomId) (v : β) : DomMap (List β) :=
  modifyAux (fun | some vs => v :: vs | none => [v]) treeDepth (hash k) k m

end DomMap

/-- Which of the answers an expectation phrase asks about (`plan` §2.2.6, `D22`, `D23`). -/
inductive Expect where
  | occurred
  | lawful
  | valid
  | violated
  | late
  | undetermined
  | conflict
  deriving Repr, DecidableEq, Inhabited

def Expect.name : Expect → String
  | .occurred => "occurred" | .lawful => "lawful" | .valid => "valid"
  | .violated => "violated" | .late => "late"
  | .undetermined => "undetermined" | .conflict => "conflict"

/-- `Var` and `Function` restrictions: a new instance replaces the previous one
(all instances / the one with the same first component). -/
inductive Restriction
  | var
  | function
  deriving Repr, DecidableEq, Inhabited

/-- A derivation rule: `Derived from` (instances generated by a term), `Holds when`
(a condition over the type's own components), or a compiled defeasible decision DAG (`D23`). -/
inductive Derivation where
  | dv (xs : List Var) (t : Term)
  | holdsWhen (t : Term)
  | defeasibleDAG (dag : List CompiledRuleNode) (rules : List DefeasibleRule)
  deriving Repr, Inhabited

/-- Who tendered a piece of evidence (005.11, D33): a name, or the value of one of the act's
components (its actor by default). Evidence is identified by the fact, its polarity, and this. -/
inductive EvSource where
  | named (s : String)
  | component (x : Var)
  deriving Repr, DecidableEq, BEq, Inhabited

def EvSource.mapDom (f : DomId → DomId) : EvSource → EvSource
  | .named s => .named s
  | .component x => .component (x.mapDom f)

/-- An effect of an act or event: create, terminate, obfuscate, tender/retract evidence,
or adjudicate a finding over every instance the term produces under `Foreach` binders. -/
inductive Effect where
  /-- Create; Charter (D7): `For d` stamps the instances with an expiry `now + d`. `imp` records
  variables implicitly bound rather than written in `Foreach` (005.4, D32). -/
  | cAll (xs : List Var) (t : Term) (forDur : Option Term := none) (imp : List Var := [])
  | tAll (xs : List Var) (t : Term) (imp : List Var := [])
  | oAll (xs : List Var) (t : Term) (imp : List Var := [])
  /-- Charter (D22, G3.2): `Supports` / `Rebuts` / `Retracts` on an `Evidenced` fact. -/
  | evOp (op : EvidenceOp) (xs : List Var) (t : Term) (src : EvSource := .named "")
  /-- Charter (D22, G3.2, Law 3): `Finding ... Resolves [!]e [Standard s]`. -/
  | findingOp (polarity : Bool) (xs : List Var) (t : Term) (standard : String := "default")
  /-- Charter (D11, D25, G3.5): rule-level `Amend` commit marker applied in `newContext`. -/
  | amendOp (actId : DomId)
  deriving Repr, Inhabited

/-- Transient internal store domain signaling a valid `Amend` transition inside `newContext`. -/
def amendCommitDom : String := "$amend_commit"

/-- `Syncs with`: the transitions triggered together with this one. -/
structure Sync where
  xs : List Var
  t  : Term
  deriving Repr, Inhabited

structure FactSpec where
  invariant    : Bool := false
  actor        : Bool := false
  /-- Charter (D22, G3.2): four-valued epistemic external-world proposition (`003.13`). -/
  evidenced    : Bool := false
  /-- Charter (D22, G3.2, T43): confidential evidence redacted outside `audiences`. -/
  confidential : Bool := false
  audiences    : List String := []
  /-- Charter (D11, D25, G3.5): `Entrenched Invariant` protected across `Amend` trajectories. -/
  entrenched   : Bool := false
  /-- Charter (D34, `#59`): initial integer value for a `Param` (or initialized `Var`). -/
  defaultVal   : Option Int := none
  /-- Charter (D35, `#53`): default epistemic polarity while `Unresolved` (`Presumed True | False`). -/
  presumed     : Option Bool := none
  /-- Charter (D35, `#55`): declared with `Input` as an exogenous environment input (`Law 6`). -/
  isInput      : Bool := false
  /-- Charter (D36, `#39`, `#40`): declared with `Role`, optionally refining `roleBase`. -/
  isRole       : Bool := false
  roleBase     : Option DomId := none
  deriving Repr, Inhabited

/-- Charter (D22, G3.2, Law 3): institutional `Finding` target and named proof standard. -/
structure FindingSpec where
  polarity : Bool := true
  target   : Term
  standard : String := "default"
  deriving Repr, Inhabited

structure ActSpec where
  effects  : List Effect := []
  syncs    : List Sync := []
  physical : Bool := false
  /-- Charter (D5): the act has institutional effect only when these hold; empty means always. -/
  validWhen : List Term := []
  /-- Charter (plan §2.2.4): performing the act is lawful iff it is also a valid, enabled
  exercise of one of these acts. -/
  exceptUnder : List DomId := []
  /-- Whether the act's second component is a `Recipient` (immunities protect recipients). -/
  hasRecipient : Bool := false
  /-- Charter (005.10, G3.1): declared with `Power`, `Finding`, or `Amend`, requiring explicit `Valid when`. -/
  isPower : Bool := false
  /-- Charter (005.11, G3.2): declared with `Finding`. -/
  isFinding : Bool := false
  finding : Option FindingSpec := none
  /-- Charter (014.3, D11, D25, G3.5): declared with `Amend`, targeting rule records. -/
  isAmend : Bool := false
  repeals : List DomId := []
  installedNames : List DomId := []
  deriving Repr, Inhabited

/-- Charter (plan §2.2.2): while an instance holds, the acts in `against` are not valid
when the instance's holder is their recipient (or when `against` covers `Amend` and the
amendment touches `protects` or reflexively protected rules, `D11`), unless one of `unlessConds` holds. -/
structure ImmunitySpec where
  against : List DomId := []
  unlessConds : List Term := []
  protects : List DomId := []
  /-- Charter (D35, `#54`): clause IDs entrenched via `Protects Clause <ID>, ...`. -/
  protectsClauses : List ClauseId := []
  /-- Charter (D35, `#52`): `true` when declared with `Protection` (dual of `Immunity`). -/
  isProtection : Bool := false
  deriving Repr, Inhabited

/-- The act-name lists are record-keeping (eFLINT); their meaning is compiled into
`violatedWhen`, and into effects and derivations of the named acts, by the resolver. -/
structure DutySpec where
  enforcingActs   : List DomId := []
  terminatingActs : List DomId := []
  creatingActs    : List DomId := []
  violatedWhen    : List Term := []
  /-- Charter (007.3): duties that take precedence: while an instance of one of them
  holds sharing this duty's bound components, this duty is not violated. -/
  overriddenBy    : List DomId := []
  /-- Charter (D35, `#57`): conditions that excuse violation while leaving the duty holding. -/
  excusedWhen     : List Term := []
  /-- Charter (D38, `#44`): `Late` conditions (`Due within d` before `Grace g` expires) and base due duration. -/
  lateWhen        : List Term := []
  dueDuration     : Option Term := none
  /-- Charter (D38, `#47`): period length for recurring `Every <period>` duties. -/
  everyPeriod     : Option Int := none
  deriving Repr, Inhabited

structure EventSpec where
  effects : List Effect := []
  syncs   : List Sync := []
  deriving Repr, Inhabited

inductive Kind where
  | fact (f : FactSpec)
  | act (a : ActSpec)
  | duty (d : DutySpec)
  | event (e : EventSpec)
  | immunity (i : ImmunitySpec)
  deriving Repr, Inhabited

def Kind.name : Kind → String
  | .fact _ => "Fact" | .act _ => "Act" | .duty _ => "Duty" | .event _ => "Event" | .immunity _ => "Immunity"

/-- The kind's name in lower case, spelled out: `String.toLower` carries a `propext` proof,
and a decided program must depend on no axioms (Law 10, 013.4). -/
def Kind.lowerName : Kind → String
  | .fact _ => "fact" | .act _ => "act" | .duty _ => "duty" | .event _ => "event" | .immunity _ => "immunity"

/-- Priority edge synthesized from `Document ... Rank n` (`012.1`, `D40`, `#73`):
`higherRule` (grounded in `higherDoc` at `higherRank`) prevails over `lowerRule` (grounded
in `lowerDoc` at `lowerRank`, with `higherRank < lowerRank`). -/
structure RankPriorityEdge where
  higherRule : String
  lowerRule  : String
  higherDoc  : String
  higherRank : Int
  lowerDoc   : String
  lowerRank  : Int
  deriving Repr, Inhabited

def RankPriorityEdge.beq (a b : RankPriorityEdge) : Bool :=
  a.higherRule == b.higherRule && a.lowerRule == b.lowerRule &&
  a.higherDoc == b.higherDoc && a.higherRank == b.higherRank &&
  a.lowerDoc == b.lowerDoc && a.lowerRank == b.lowerRank

instance : BEq RankPriorityEdge := ⟨RankPriorityEdge.beq⟩

/-- One type declaration (eFLINT `TypeSpec`). `closed = none` means closed by
default and still openable; `some b` is an explicit setting. -/
structure TypeSpec where
  kind             : Kind
  domain           : Domain
  domainConstraint : Term := .boolLit true
  restriction      : Option Restriction := none
  derivation       : List Derivation := []
  closed           : Option Bool := none
  conditions       : List Term := []
  /-- Charter (D4, Law 8): the clause spans this rule is the meaning of (`From CLAUSE "span"`). -/
  spans            : List (ClauseId × String) := []
  /-- Charter (D23, G3.3): named `Default` / `Exception` rules and `Priority` edges. -/
  defeasibleRules  : List DefeasibleRule := []
  priorityEdges    : List (String × String) := []
  deriving Repr, Inhabited

def TypeSpec.isClosed (t : TypeSpec) : Bool := t.closed.getD true

def TypeSpec.isEvidencedFact (t : TypeSpec) : Bool :=
  match t.kind with
  | .fact fs => fs.evidenced
  | _ => false

def TypeSpec.factPresumed (t : TypeSpec) : Option Bool :=
  match t.kind with
  | .fact fs => fs.presumed
  | _ => none

/-! ## Surface declarations -/

/-- A clause of a declaration or `Extend` (eFLINT `ModClause`). -/
inductive ModClause where
  | conditionedBy (ts : List Term)
  | derivation (ds : List Derivation)
  | postCond (effs : List Effect)
  | sync (ss : List Sync)
  | violation (ts : List Term)
  | enforcingActs (as : List DomId)
  | terminatedBy (as : List DomId)
  | createdBy (as : List DomId)
  /-- Charter (007.3): `Overridden by` on a duty. -/
  | overriddenBy (ds : List DomId)
  | strings (ss : List String)
  | ints (is : List Int)
  | close
  | open
  /-- Charter: `Valid when` on an act. -/
  | validWhen (ts : List Term)
  /-- Charter: `Except under` on an act. -/
  | exceptUnder (as : List DomId)
  /-- Charter: `Against` on an immunity. -/
  | against (as : List DomId)
  /-- Charter: `Unless` on an immunity. -/
  | unlessCond (ts : List Term)
  /-- Charter (D7): `Due within d` on a duty: violated once held for `d`. -/
  | dueWithin (d : Term)
  | dueWithinGrace (d : Term) (grace : Term)
  | dueWithinAfter (d : Term) (afterEv : Term)
  | lateWhen (ts : List Term)
  /-- Charter (D4): `From CLAUSE "span"`: the English this rule is the meaning of. -/
  | fromSpan (clause : ClauseId) (text : String)
  /-- Charter (D22, G3.2): `Evidenced` and `Confidential [To ...]` on a fact. -/
  | evidenced
  | confidential (audiences : List String)
  /-- Charter (D22, D35, G3.2): `Resolves [!]e`, `Decides e ...`, and `Standard s` on a `Finding` act. -/
  | resolves (polarity : Bool) (t : Term)
  | decides (target : Term) (cond : Term)
  | standard (s : String)
  /-- Charter (D22, G3.2): `Supports` / `Rebuts` / `Retracts` on an act (pre-compilation). -/
  | evEffect (op : EvidenceOp) (ts : List (List Var × Term)) (src? : Option Term := none)
  /-- Charter (D23, G3.3): `Default` / `Exception ... Overrides ...` and `Priority ... Over ...`. -/
  | defeasibleRule (r : DefeasibleRule)
  | priorityEdge (higher : String) (lowers : List String)
  /-- Charter (D11, D25, G3.5): `Repeals <id, ...>` on `Amend`, `Protects <id, ...>` on `Immunity`, `Entrenched` on `Invariant`. -/
  | repeals (ids : List DomId)
  | protects (ids : List DomId)
  | protectsClauses (cids : List ClauseId)
  | entrenched
  | presumed (polarity : Bool)
  | excusedWhen (ts : List Term)
  | overridesDuties (targets : List (DomId × Option Args))
  /-- Charter (D36, `#50`): `Decided by <voter> [Weighted by <fn>] At least <num>/<den> In <voteFact>`. -/
  | decidedBy (voter : Var) (weightFn : Option DomId) (num den : Int) (voteFact : DomId)
  /-- Source-span wrapper (`#27`): stripped when applied to `TypeSpec` so `CIR` stays position-free. -/
  | atPos (pos : Pos) (c : ModClause)
  deriving Repr, Inhabited

def ModClause.stripPos : ModClause → ModClause
  | .atPos _ c => c.stripPos
  | c => c

def ModClause.unpos : ModClause → Pos × ModClause
  | .atPos p c =>
    let (p', c') := c.unpos
    (if p' == {} then p else p', c')
  | c => ({}, c)

/-- Temporal property formulae (`docs/rfc.md` §7.4, `D20`), verified in `Charter.Verify`
without widening `Charter.Eval`. -/
inductive TemporalFormula where
  | always (phi : Term)
  | alwaysNext (ante : Term) (post : Term)
  | alwaysEventually (req : Term) (resp : Term)
  | alwaysEventuallyWithin (bound : Term) (req : Term) (resp : Term)
  | until_ (phi : Term) (psi : Term)
  | weakUntil (phi : Term) (psi : Term)
  deriving Repr, Inhabited

def TemporalFormula.mapDom (f : DomId → DomId) : TemporalFormula → TemporalFormula
  | .always p => .always (p.mapDom f)
  | .alwaysNext a b => .alwaysNext (a.mapDom f) (b.mapDom f)
  | .alwaysEventually a b => .alwaysEventually (a.mapDom f) (b.mapDom f)
  | .alwaysEventuallyWithin d a b => .alwaysEventuallyWithin (d.mapDom f) (a.mapDom f) (b.mapDom f)
  | .until_ a b => .until_ (a.mapDom f) (b.mapDom f)
  | .weakUntil a b => .weakUntil (a.mapDom f) (b.mapDom f)

structure TemporalSpec where
  name        : DomId
  assumptions : List String := []
  formula     : TemporalFormula
  spans       : List (ClauseId × String) := []
  deriving Repr, Inhabited

def TemporalSpec.mapDom (f : DomId → DomId) (tp : TemporalSpec) : TemporalSpec :=
  { tp with name := f tp.name, formula := tp.formula.mapDom f }

structure RegimeSpec where
  name   : String
  params : List (DomId × Int) := []
  deriving Repr, DecidableEq, Inhabited

/-- A declaration: a new type, an extension of one, or a placeholder alias. -/
inductive Decl where
  | typeDecl (d : DomId) (t : TypeSpec)
  | typeExt (d : DomId) (clauses : List ModClause) (extKind : String := "Fact")
  | placeholder (f t : DomId)
  /-- Charter (D4): a clause of the authoritative document with its register spans. -/
  | clause (c : Clause)
  /-- Charter (D4, G3.1): `Document [ID] "path" [SHA256 "hex"] [Rank n]`. -/
  | document (path : String) (docId : Option String := none) (sha256 : Option String := none) (rank : Option Int := none)
  /-- Charter (D11): `Param name [: Int|Time|Duration] = n`, a `Var` fact with an initial instance. -/
  | param (name : DomId) (dom : Domain) (value : Int)
  /-- Charter (D8): `Module name(params) { declarations }`. -/
  | module (name : DomId) (params : List DomId) (body : List Decl)
  /-- Charter (D8, D34, `#62`): `Use name(args) [As prefix] [From ...]`: instantiate a module. -/
  | use (name : DomId) (args : List DomId) (pre : Option String) (spans : List (ClauseId × String) := [])
  /-- Charter (D34, `#36`): ground-fact initial assertion from a `Clause` span (`=> named(House, Anna)`). -/
  | spanInit (t : Term)
  /-- Charter (D20): `Property name [Assumes ...] When <TemporalFormula> [From ...]`. -/
  | property (tp : TemporalSpec)
  /-- Charter (D11, D25, G3.5): `Installs { decls }` attached to an `Amend` act. -/
  | amendInstall (actId : DomId) (body : List Decl)
  /-- Charter (D11, D25, G3.5): `Regime name { param = val, ... }` initial-state overlay. -/
  | regime (r : RegimeSpec)
  /-- Charter (D35, `#54`): `Amend Procedure ... Valid when <cond>` default competence rule. -/
  | amendProcedure (conds : List Term)
  /-- Charter (D36, `#46`): `Amount <name> [: <Dom>] Is <expr>` named derived scalar value. -/
  | amountDef (name : DomId) (dom? : Option Domain) (expr : Term)
  /-- Charter (D37, `#42`): idempotently ensure carrier `Fact <name> Identified by <dom>`. -/
  | ensureCarrier (name : DomId) (dom : Domain)
  /-- Charter (D37, `#42`): initial value assignment `Var <name> : <dom> = <expr>` at Genesis. -/
  | varInit (name : DomId) (expr : Term)
  /-- Charter (`#67`): `Expose [Act|Event|Input|Fact] <id>, ...` service boundary declaration. -/
  | expose (category : String) (targets : List DomId)
  /-- Charter (`#71`): `Migrates { ... }` deterministic state migration on an `Amend` act. -/
  | amendMigrate (actId : DomId) (effects : List Effect)
  /-- Charter (`#76`): `ActorKey <actor> "<pubKeyHex>"` binding an actor to a public key in `Spec`. -/
  | actorKey (actor : String) (pubKeyHex : String)
  /-- Source-span wrapper (`#27`): stripped when inserted into `Spec` so `CIR` stays position-free. -/
  | atPos (pos : Pos) (d : Decl)
  deriving Repr, Inhabited

def Decl.stripPos : Decl → Decl
  | .atPos _ d => d.stripPos
  | d => d

def Decl.unpos : Decl → Pos × Decl
  | .atPos p d =>
    let (p', d') := d.unpos
    (if p' == {} then p else p', d')
  | d => ({}, d)

mutual
def Decl.stripAllPos : Decl → Decl
  | .atPos _ d => d.stripAllPos
  | .typeExt d cls k => .typeExt d (cls.map ModClause.stripPos) k
  | .module n ps body => .module n ps (Decl.stripAllPosList body)
  | .amendInstall a body => .amendInstall a (Decl.stripAllPosList body)
  | d => d

def Decl.stripAllPosList : List Decl → List Decl
  | [] => []
  | d :: ds => d.stripAllPos :: Decl.stripAllPosList ds
end

def Decl.isInitial : Decl → Bool
  | .atPos _ d => d.isInitial
  | .typeDecl .. => true
  | .placeholder .. => true
  | .typeExt .. => false
  | .clause .. => true
  | .document .. => true
  | .param .. => true
  | .module .. => true
  | .use .. => true
  | .spanInit .. => false
  | .property .. => false
  | .amendInstall .. => false
  | .regime .. => false
  | .amendProcedure .. => true
  | .amountDef .. => true
  | .ensureCarrier .. => true
  | .varInit .. => false
  | .expose .. => false
  | .amendMigrate .. => false
  | .actorKey .. => false

def Decl.name : Decl → DomId
  | .atPos _ d => d.name
  | .typeDecl d _ => d
  | .typeExt d _ _ => d
  | .placeholder f _ => f
  | .clause c => c.id
  | .document p _ _ _ => p
  | .param n _ _ => n
  | .module n _ _ => n
  | .use n _ _ _ => n
  | .spanInit _ => ""
  | .property tp => tp.name
  | .amendInstall a _ => a
  | .regime r => r.name
  | .amendProcedure _ => ""
  | .amountDef n _ _ => n
  | .ensureCarrier n _ => n
  | .varInit n _ => n
  | .expose _ ts => ts.headD ""
  | .amendMigrate a _ => a
  | .actorKey a _ => a

/-- The declared types and placeholder aliases of a program. Insertion replaces
an existing entry (eFLINT's `M.insert`; see brief B9 for the pending ruling). -/
structure Spec where
  decls   : List (DomId × TypeSpec) := []
  aliases : List (DomId × DomId) := []
  /-- Charter (D4): the authoritative English document, as `Document "path"` names it. -/
  document : Option String := none
  /-- Charter (G3.1): multi-document source authority manifest (`Document [ID] "path" [SHA256 ...]`). -/
  documents : List SourceDoc := []
  /-- Charter (D4): the clauses with their register spans. -/
  clauses  : List Clause := []
  /-- Charter (D10, Law 8): declared scenarios, by name, with their `From` spans. -/
  scenarios : List (String × List (ClauseId × String)) := []
  /-- Charter (D8): declared modules, by name: their parameters and body. -/
  modules  : List (DomId × List DomId × List Decl) := []
  /-- Charter (D20): declared temporal properties (`Property`), consumed by `Verify/`. -/
  temporalProperties : List TemporalSpec := []
  /-- Charter (D11, D25, G3.5): `Installs { ... }` rule payloads per `Amend` act. -/
  amendBodies : List (DomId × List Decl) := []
  /-- Charter (D11, D25, G3.5): declared `Regime` initial-state parameter overlays. -/
  regimes : List RegimeSpec := []
  /-- Charter (D35, `#54`): default `Valid when` competence conditions declared by `Amend Procedure`. -/
  amendProcedure : List Term := []
  /-- Charter (D38, `#49`, `#43`): `true` when `Done`/`Since`/`Before`/`Within`/`?occurred` is used, enabling `$occ` transition stamping. -/
  tracksHistory : Bool := false
  rankEdges     : List (DomId × RankPriorityEdge) := []
  amendMigrations : List (DomId × List Effect) := []
  serviceInterfaceDeclared : Bool := false
  exposedActs   : List DomId := []
  exposedInputs : List DomId := []
  actorKeys     : List (String × String) := []
  deriving Repr, Inhabited

namespace Spec

def lookupDecl (s : Spec) (d : DomId) : Option TypeSpec :=
  (s.decls.find? (·.1 == d)).map (·.2)

def insertDecl (s : Spec) (d : DomId) (t : TypeSpec) : Spec :=
  { s with decls := (d, t) :: s.decls.filter (·.1 != d) }

def adjustDecl (s : Spec) (d : DomId) (f : TypeSpec → TypeSpec) : Spec :=
  { s with decls := s.decls.map fun (d', t) => if d' == d then (d', f t) else (d', t) }

def insertAlias (s : Spec) (f t : DomId) : Spec :=
  { s with aliases := (f, t) :: s.aliases.filter (·.1 != f) }

/-- Insert or replace a `SourceDoc` entry and keep `document` pointing at the primary path. -/
def insertDocument (s : Spec) (sd : SourceDoc) : Spec :=
  let docs' := match sd.id with
    | some id => s.documents.filter (·.id != some id) ++ [sd]
    | none => s.documents.filter (·.path != sd.path) ++ [sd]
  let prim := match s.document, sd.id with
    | none, _ => some sd.path
    | some _, none => some sd.path
    | some p, some _ => some p
  { s with document := prim, documents := docs' }

/-- Insert a clause, replacing one with the same id; clauses keep declaration order. -/
def insertClause (s : Spec) (c : Clause) : Spec :=
  { s with clauses := s.clauses.filter (·.id != c.id) ++ [c] }

/-- Whether any declared type in `s` is an `Evidenced` fact (`003.13`, fast-path guard). -/
def hasEvidencedFacts (s : Spec) : Bool :=
  s.decls.any fun (_, t) => t.isEvidencedFact

/-- Whether any declared type in `s` carries defeasible `Default` / `Exception` rules (`004.12`). -/
def hasDefeasibleRules (s : Spec) : Bool :=
  s.decls.any fun (_, t) => !t.defeasibleRules.isEmpty

/-- Whether three-valued guard evaluation (`evalActTri`) may observe epistemic or conflict indeterminacy. -/
def hasEpistemicOrDefeasible (s : Spec) : Bool :=
  s.hasEvidencedFacts || s.hasDefeasibleRules

/-- Insert or replace a temporal property in declaration order. -/
def insertTemporal (s : Spec) (tp : TemporalSpec) : Spec :=
  { s with temporalProperties := s.temporalProperties.filter (·.name != tp.name) ++ [tp] }

/-- Record a scenario and its `From` spans in declaration order. -/
def insertScenario (s : Spec) (name : String) (spans : List (ClauseId × String)) : Spec :=
  { s with scenarios := s.scenarios.filter (·.1 != name) ++ [(name, spans)] }

/-- The rules a provenance check must account for: acts, duties, immunities, and invariants
(including normative rules declared inside `Amend ... Installs { ... }`, `012.6`, `#24`). -/
def ruleIds (s : Spec) : List DomId :=
  let isRuleKind : Kind → Bool
    | .act _ | .duty _ | .immunity _ => true
    | .fact f => f.invariant
    | _ => false
  let topRules := s.decls.filterMap fun (p : DomId × TypeSpec) =>
    if isRuleKind p.2.kind then some p.1 else none
  let installedRules := s.amendBodies.flatMap fun (_, ds) =>
    ds.filterMap fun d => match d.stripPos with
      | .typeDecl bty bts => if isRuleKind bts.kind then some bty else none
      | _ => none
  (topRules ++ installedRules).eraseDups

/-- All formal identifiers a `Clause` span may cite (`012.5`, `D34`, `#36`): every declared type
(facts, derived facts, parameters, events, acts, powers, findings, amendments, duties, immunities,
invariants, including those in `Installs { ... }`), placeholders, and named `Default`/`Exception` rule IDs (`r` and `ty.r`). -/
def citeableIds (s : Spec) : List String :=
  let declNames := s.decls.map (·.1)
  let installedDecls : List (DomId × TypeSpec) := s.amendBodies.flatMap fun (_, ds) =>
    ds.filterMap fun d => match d.stripPos with | .typeDecl bty bts => some (bty, bts) | _ => none
  let instNames := installedDecls.map (·.1)
  let aliasNames := s.aliases.map (·.1)
  let defRules := (s.decls ++ installedDecls).flatMap fun (ty, ts) =>
    ts.defeasibleRules.flatMap fun r => [r.id, s!"{ty}.{r.id}"]
  (declNames ++ instNames ++ aliasNames ++ defRules).eraseDups

/-- Follow placeholder aliases (eFLINT `chase_alias`); fuel bounds a cycle. -/
def chaseAlias (s : Spec) (d : DomId) : DomId :=
  if s.aliases.isEmpty then d else go (s.aliases.length + 1) d
where
  go : Nat → DomId → DomId
    | 0, d => d
    | n + 1, d => match s.aliases.find? (·.1 == d) with
      | some (_, d') => if d' == d then d else go n d'
      | none => d

def findDecl (s : Spec) (d : DomId) : Option TypeSpec := s.lookupDecl (s.chaseAlias d)

def removeDecoration (s : Spec) (x : Var) : DomId := s.chaseAlias x.dom

def closedType (s : Spec) (d : DomId) : Option Bool := (s.findDecl d).map (·.isClosed)

def restrictionOf (s : Spec) (d : DomId) : Option Restriction :=
  (s.findDecl d).bind (·.restriction)

/-- Whether every instance of a domain can be listed (eFLINT `enumerable`). Fuel
bounds a cyclic product declaration. -/
def enumerableFuel (s : Spec) : Nat → Domain → Bool
  | _, .strings _ => true
  | _, .ints _ => true
  | 0, .products _ => false
  | n + 1, .products xs => xs.all fun x => match s.findDecl (s.removeDecoration x) with
    | some t => enumerableFuel s n t.domain
    | none => false
  | _, .anyString => false
  | _, .anyInt => false
  | _, .time => false
  | _, .duration => false
  | _, .money _ _ => false
  | _, .quantity _ => false
  | _, .rate => false

def enumerable (s : Spec) (dom : Domain) : Bool := s.enumerableFuel (s.decls.length + 1) dom

/-- Charter (D15, brief B11): the `Holds when` clauses of an act whose domain is not
enumerable. Such an act is never materialised by saturation; it is judged for the
instance asked about (`Enabled`, `?lawful`, a performance), with its components bound.
`none` for anything else: a fact, an enumerable act, or an act with no `Holds when`. -/
def judgedAct (s : Spec) (d : DomId) : Option (List Term) :=
  match s.findDecl d with
  | some t =>
    match t.kind with
    | .act _ =>
      if s.enumerable t.domain then none
      else
        let clauses := t.derivation.filterMap fun | .holdsWhen c => some c | _ => none
        if clauses.isEmpty then none else some clauses
    | _ => none
  | none => none

/-- The `Holds when` clauses of an act or immunity whose domain is not enumerable,
judged for the instance asked about with its components bound. -/
def judgedRule (s : Spec) (d : DomId) : Option (List Term) :=
  match s.findDecl d with
  | some t =>
    match t.kind with
    | .act _ | .immunity _ =>
      if s.enumerable t.domain then none
      else
        let clauses := t.derivation.filterMap fun | .holdsWhen c => some c | _ => none
        if clauses.isEmpty then none else some clauses
    | _ => none
  | none => none

def kindOf (s : Spec) (d : DomId) : Option Kind := (s.findDecl d).map (·.kind)

def triggerable (s : Spec) (d : DomId) : Bool :=
  match s.findDecl d with
  | some t => match t.kind with
    | .act _ => true
    | .event _ => true
    | _ => false
  | none => false

def dutyDecls (s : Spec) : List (DomId × DutySpec) :=
  s.decls.filterMap fun (p : DomId × TypeSpec) => match p.2.kind with | .duty ds => some (p.1, ds) | _ => none

def triggerDecls (s : Spec) : List DomId :=
  s.decls.filterMap fun (p : DomId × TypeSpec) => match p.2.kind with | .act _ => some p.1 | .event _ => some p.1 | _ => none

def findViolationCond (s : Spec) (d : DomId) : Option (List Term) :=
  match s.findDecl d with
  | some t => match t.kind with
    | .duty ds => some ds.violatedWhen
    | _ => none
  | none => none

def invariants (s : Spec) : List DomId :=
  s.decls.filterMap fun (p : DomId × TypeSpec) => match p.2.kind with | .fact f => if f.invariant then some p.1 else none | _ => none

def entrenchedInvariants (s : Spec) : List DomId :=
  s.decls.filterMap fun (p : DomId × TypeSpec) => match p.2.kind with
    | .fact f => if f.invariant && f.entrenched then some p.1 else none
    | _ => none

def insertRegime (s : Spec) (r : RegimeSpec) : Spec :=
  { s with regimes := s.regimes.filter (·.name != r.name) ++ [r] }

def insertAmendBody (s : Spec) (actId : DomId) (ds : List Decl) : Spec :=
  let prev := (s.amendBodies.find? (·.1 == actId)).map (·.2) |>.getD []
  { s with amendBodies := s.amendBodies.filter (·.1 != actId) ++ [(actId, prev ++ ds)] }

def insertAmendMigration (s : Spec) (actId : DomId) (effs : List Effect) : Spec :=
  let prev := (s.amendMigrations.find? (·.1 == actId)).map (·.2) |>.getD []
  { s with amendMigrations := s.amendMigrations.filter (·.1 != actId) ++ [(actId, prev ++ effs)] }

def insertExposedAct (s : Spec) (d : DomId) : Spec :=
  let acts := if s.exposedActs.contains d then s.exposedActs else s.exposedActs ++ [d]
  { s with serviceInterfaceDeclared := true, exposedActs := acts }

def insertExposedInput (s : Spec) (d : DomId) : Spec :=
  let inps := if s.exposedInputs.contains d then s.exposedInputs else s.exposedInputs ++ [d]
  { s with serviceInterfaceDeclared := true, exposedInputs := inps }

def insertActorKey (s : Spec) (actor pubKeyHex : String) : Spec :=
  { s with actorKeys := s.actorKeys.filter (·.1 != actor) ++ [(actor, pubKeyHex)] }

/-- All declared `Immunity` and `Protection` entries, pre-extracted once per `Spec` (`#78`). -/
def allImmunities (s : Spec) : List (DomId × TypeSpec × ImmunitySpec) :=
  s.decls.filterMap fun (p : DomId × TypeSpec) => match p.2.kind with
    | .immunity i => some (p.1, p.2, i)
    | _ => none

/-- The immunity types naming `a` in `Against`, with their specs (excluding `Protection`s). -/
def immunitiesAgainst (s : Spec) (a : DomId) : List (DomId × TypeSpec × ImmunitySpec) :=
  s.decls.filterMap fun (p : DomId × TypeSpec) => match p.2.kind with
    | .immunity i => if !i.isProtection && i.against.contains a then some (p.1, p.2, i) else none
    | _ => none

/-- The `Protection` types naming `a` in `For` (`D35`, `#52`), dual to `immunitiesAgainst`. -/
def protectionsFor (s : Spec) (a : DomId) : List (DomId × TypeSpec × ImmunitySpec) :=
  s.decls.filterMap fun (p : DomId × TypeSpec) => match p.2.kind with
    | .immunity i => if i.isProtection && i.against.contains a then some (p.1, p.2, i) else none
    | _ => none

/-- The immunity types covering an `Amend` act `a` (naming `a` or `"Amend"` in `Against`). -/
def immunitiesAgainstAmend (s : Spec) (a : DomId) : List (DomId × TypeSpec × ImmunitySpec) :=
  s.decls.filterMap fun (p : DomId × TypeSpec) => match p.2.kind with
    | .immunity i => if !i.isProtection && (i.against.contains a || i.against.contains "Amend") then some (p.1, p.2, i) else none
    | _ => none

def derivedTypes (s : Spec) : List DomId :=
  s.decls.filterMap fun (p : DomId × TypeSpec) =>
    if p.2.derivation.isEmpty then none
    else if (s.judgedRule p.1).isSome && p.2.derivation.all (fun | .holdsWhen _ => true | _ => false) then none
    else some p.1

/-- The component variables an instance of `d` binds: its product components, or
the undecorated type itself for a primitive domain. -/
def components (s : Spec) (d : DomId) : List Var :=
  match s.findDecl d with
  | some t => match t.domain with
    | .products xs => xs
    | _ => [⟨d, ""⟩]
  | none => [⟨d, ""⟩]

/-- Precomputed per-type entry for `Eval`: `(tspec, isEnumerable, judgedRule)`. -/
abbrev SpecIndex := DomMap (TypeSpec × Bool × Option (List Term))

def enumerableWithMap (s : Spec) (declMap : DomMap TypeSpec) : Nat → Domain → Bool
  | _, .strings _ => true
  | _, .ints _ => true
  | 0, .products _ => false
  | n + 1, .products xs => xs.all fun x => match declMap.lookup (s.removeDecoration x) with
    | some t => enumerableWithMap s declMap n t.domain
    | none => false
  | _, .anyString => false
  | _, .anyInt => false
  | _, .time => false
  | _, .duration => false
  | _, .money _ _ => false
  | _, .quantity _ => false
  | _, .rate => false

def buildIndex (s : Spec) : SpecIndex :=
  let declMap : DomMap TypeSpec := s.decls.foldr (fun (d, t) m => m.insert d t) .empty
  let maxDepth := 16
  let base := s.decls.foldr (fun (d, t) m =>
    let isEnum := enumerableWithMap s declMap maxDepth t.domain
    let judged := match t.kind with
      | .act _ | .immunity _ =>
        if isEnum then none
        else
          let cs := t.derivation.filterMap fun | .holdsWhen c => some c | _ => none
          if cs.isEmpty then none else some cs
      | _ => none
    m.insert d (t, isEnum, judged)) .empty
  s.aliases.foldr (fun (f, _) m =>
    let target := s.chaseAlias f
    match base.lookup target with
    | some entry => m.insert f entry
    | none => m) base

end Spec

/-- The bindings an instance makes: product components to their arguments, or the
undecorated type to the element itself. -/
def Tagged.bindings (dom : Domain) (te : Tagged) : List (Var × Tagged) :=
  match dom, te.1 with
  | .products xs, .prod args => xs.zip args
  | _, _ => [(⟨te.2, ""⟩, te)]

/-- Built-in declarations: `int`, `string`, and `actor`. -/
def actorDecl : TypeSpec :=
  { kind := .fact { actor := true }, domain := .anyString }

def intDecl : TypeSpec := { kind := .fact {}, domain := .anyInt }

def stringDecl : TypeSpec := { kind := .fact {}, domain := .anyString }

def emptySpec : Spec :=
  { decls := [("int", intDecl), ("string", stringDecl), ("actor", actorDecl)], aliases := [] }

/-- Recompute the compiled topological decision DAG inside `t.derivation` from `t.defeasibleRules`,
`t.priorityEdges`, and any `Document Rank` edges `rankPairs` not superseded by explicit `Overrides`/`Priority` (`D23`, `D40`). -/
def TypeSpec.syncDefeasibleDAG (t : TypeSpec) (rankPairs : List (String × String) := []) : TypeSpec :=
  let nonDef := t.derivation.filter fun | .defeasibleDAG _ _ => false | _ => true
  if t.defeasibleRules.isEmpty then { t with derivation := nonDef }
  else
    let ovEdges := t.defeasibleRules.flatMap fun r => r.overrides.map (r.id, ·)
    let explicitEdges := ovEdges ++ t.priorityEdges
    let fuel := t.defeasibleRules.length + 2
    let activeRank := rankPairs.filter fun (hi, lo) =>
      !Defeasible.reaches fuel explicitEdges hi lo &&
      !Defeasible.reaches fuel explicitEdges lo hi
    let allEdges := explicitEdges ++ activeRank
    let dag := Defeasible.compileDefeasibleDAG (t.defeasibleRules.map (·.id)) allEdges
    { t with derivation := nonDef ++ [.defeasibleDAG dag t.defeasibleRules] }

/-- Apply compiled extension clauses to a type (eFLINT `apply_type_ext`). -/
def TypeSpec.applyExt (clauses : List ModClause) (t : TypeSpec) : TypeSpec :=
  (clauses.map ModClause.stripPos).foldr apply t
where
  apply (c : ModClause) (t : TypeSpec) : TypeSpec :=
    match c with
    | .close => { t with closed := t.closed.map (fun _ => true) }
    | .open => { t with closed := some (t.closed.getD false) }
    | .conditionedBy conds => { t with conditions := conds ++ t.conditions }
    | .derivation dvs => { t with derivation := dvs ++ t.derivation }
    | .postCond effs => { t with kind := match t.kind with
        | .act a => .act { a with effects := effs ++ a.effects }
        | .event e => .event { e with effects := effs ++ e.effects }
        | k => k }
    | .sync ss => { t with kind := match t.kind with
        | .act a => .act { a with syncs := ss ++ a.syncs }
        | .event e => .event { e with syncs := ss ++ e.syncs }
        | k => k }
    | .violation vs => { t with kind := match t.kind with
        | .duty d => .duty { d with violatedWhen := vs ++ d.violatedWhen }
        | k => k }
    | .enforcingActs as => { t with kind := match t.kind with
        | .duty d => .duty { d with enforcingActs := as ++ d.enforcingActs }
        | k => k }
    | .terminatedBy as => { t with kind := match t.kind with
        | .duty d => .duty { d with terminatingActs := as ++ d.terminatingActs }
        | k => k }
    | .createdBy as => { t with kind := match t.kind with
        | .duty d => .duty { d with creatingActs := as ++ d.creatingActs }
        | k => k }
    | .overriddenBy ds => { t with kind := match t.kind with
        | .duty d => .duty { d with overriddenBy := ds ++ d.overriddenBy }
        | k => k }
    | .strings ss => { t with domain := match t.domain with
        | .anyString => .strings ss
        | .strings ss' => .strings (ss' ++ ss)
        | d => d }
    | .ints is => { t with domain := match t.domain with
        | .anyInt => .ints is
        | .ints is' => .ints (is' ++ is)
        | d => d }
    | .validWhen ts => { t with kind := match t.kind with
        | .act a => .act { a with validWhen := ts ++ a.validWhen }
        | k => k }
    | .exceptUnder as => { t with kind := match t.kind with
        | .act a => .act { a with exceptUnder := as ++ a.exceptUnder }
        | k => k }
    | .against as => { t with kind := match t.kind with
        | .immunity i => .immunity { i with against := as ++ i.against }
        | k => k }
    | .unlessCond ts => { t with kind := match t.kind with
        | .immunity i => .immunity { i with unlessConds := ts ++ i.unlessConds }
        | k => k }
    -- `Due within d` is desugared by the resolver into a `Violated when Held(d()) For d`
    -- clause (006.7); it never reaches a record unresolved
    | .dueWithin d =>
      { t with kind := match t.kind with
          | .duty ds => .duty { ds with dueDuration := some d }
          | k => k }
    | .dueWithinGrace _ _ => t
    | .dueWithinAfter _ _ => t
    | .lateWhen ls =>
      { t with kind := match t.kind with
          | .duty d => .duty { d with lateWhen := ls ++ d.lateWhen }
          | k => k }
    | .fromSpan c text => { t with spans := t.spans ++ [(c, text)] }
    | .evidenced =>
      { t with
        closed := some false
        kind := match t.kind with
          | .fact fs => .fact { fs with evidenced := true }
          | k => k }
    | .confidential auds =>
      { t with
        kind := match t.kind with
          | .fact fs => .fact { fs with confidential := true, audiences := (fs.audiences ++ auds).eraseDups }
          | k => k }
    | .resolves pol target =>
      { t with
        kind := match t.kind with
          | .act a =>
            let std := match a.finding with | some f => f.standard | none => "default"
            .act { a with isFinding := true, isPower := true, finding := some { polarity := pol, target, standard := std } }
          | k => k }
    | .decides target _ =>
      { t with
        kind := match t.kind with
          | .act a =>
            let std := match a.finding with | some f => f.standard | none => "default"
            .act { a with isFinding := true, isPower := true, finding := some { polarity := true, target, standard := std } }
          | k => k }
    | .standard std =>
      { t with
        kind := match t.kind with
          | .act a =>
            let f' := match a.finding with
              | some f => some { f with standard := std }
              | none => some { polarity := true, target := .boolLit true, standard := std }
            let effs' := a.effects.map fun
              | .findingOp pol xs tm _ => .findingOp pol xs tm std
              | eff => eff
            .act { a with finding := f', effects := effs' }
          | k => k }
    | .evEffect .. => t
    | .defeasibleRule r =>
      TypeSpec.syncDefeasibleDAG { t with defeasibleRules := t.defeasibleRules ++ [r] }
    | .priorityEdge hi los =>
      let newEdges := los.map (hi, ·)
      TypeSpec.syncDefeasibleDAG { t with priorityEdges := t.priorityEdges ++ newEdges }
    | .repeals rs =>
      { t with kind := match t.kind with
          | .act a => .act { a with isAmend := true, isPower := true, repeals := (a.repeals ++ rs).eraseDups }
          | k => k }
    | .protects ps =>
      { t with kind := match t.kind with
          | .immunity im => .immunity { im with protects := (im.protects ++ ps).eraseDups }
          | k => k }
    | .entrenched =>
      { t with kind := match t.kind with
          | .fact fs => .fact { fs with entrenched := true }
          | k => k }
    | .presumed pol =>
      { t with kind := match t.kind with
          | .fact fs => .fact { fs with presumed := some pol }
          | k => k }
    | .protectsClauses cids =>
      { t with kind := match t.kind with
          | .immunity im => .immunity { im with protectsClauses := (im.protectsClauses ++ cids).eraseDups }
          | k => k }
    | .excusedWhen ts =>
      { t with kind := match t.kind with
          | .duty d => .duty { d with excusedWhen := ts ++ d.excusedWhen }
          | k => k }
    | .overridesDuties _ => t
    | .decidedBy _ _ _ _ _ => t
    | .atPos _ _ => t

/-! ## Renaming (module instantiation, D8) -/

def Derivation.mapDom (f : DomId → DomId) : Derivation → Derivation
  | .dv xs t => .dv (xs.map (Var.mapDom f)) (t.mapDom f)
  | .holdsWhen t => .holdsWhen (t.mapDom f)
  | .defeasibleDAG dag rs => .defeasibleDAG dag (rs.map (DefeasibleRule.mapDom f))

def Effect.mapDom (f : DomId → DomId) : Effect → Effect
  | .cAll xs t d imp => .cAll (xs.map (Var.mapDom f)) (t.mapDom f) (d.map (·.mapDom f)) (imp.map (Var.mapDom f))
  | .tAll xs t imp => .tAll (xs.map (Var.mapDom f)) (t.mapDom f) (imp.map (Var.mapDom f))
  | .oAll xs t imp => .oAll (xs.map (Var.mapDom f)) (t.mapDom f) (imp.map (Var.mapDom f))
  | .evOp op xs t src => .evOp op (xs.map (Var.mapDom f)) (t.mapDom f) (src.mapDom f)
  | .findingOp pol xs t std => .findingOp pol (xs.map (Var.mapDom f)) (t.mapDom f) std
  | .amendOp actId => .amendOp (f actId)

def FindingSpec.mapDom (f : DomId → DomId) (fs : FindingSpec) : FindingSpec :=
  { fs with target := fs.target.mapDom f }

def Sync.mapDom (f : DomId → DomId) (s : Sync) : Sync := ⟨s.xs.map (Var.mapDom f), s.t.mapDom f⟩

def Kind.mapDom (f : DomId → DomId) : Kind → Kind
  | .fact x => .fact x
  | .act a =>
    .act { a with
      effects := a.effects.map (Effect.mapDom f)
      syncs := a.syncs.map (Sync.mapDom f)
      validWhen := a.validWhen.map (Term.mapDom f)
      exceptUnder := a.exceptUnder.map f
      finding := a.finding.map (FindingSpec.mapDom f)
      repeals := a.repeals.map f
      installedNames := a.installedNames.map f }
  | .duty d =>
    .duty { d with
      enforcingActs := d.enforcingActs.map f
      terminatingActs := d.terminatingActs.map f
      creatingActs := d.creatingActs.map f
      violatedWhen := d.violatedWhen.map (Term.mapDom f)
      overriddenBy := d.overriddenBy.map f
      excusedWhen := d.excusedWhen.map (Term.mapDom f)
      lateWhen := d.lateWhen.map (Term.mapDom f)
      dueDuration := d.dueDuration.map (·.mapDom f) }
  | .event e => .event { e with effects := e.effects.map (Effect.mapDom f), syncs := e.syncs.map (Sync.mapDom f) }
  | .immunity i => .immunity { i with against := i.against.map f, unlessConds := i.unlessConds.map (Term.mapDom f), protects := i.protects.map f }

def TypeSpec.mapDom (f : DomId → DomId) (t : TypeSpec) : TypeSpec :=
  { t with
    kind := t.kind.mapDom f
    domain := t.domain.mapDom f
    domainConstraint := t.domainConstraint.mapDom f
    derivation := t.derivation.map (Derivation.mapDom f)
    conditions := t.conditions.map (Term.mapDom f)
    defeasibleRules := t.defeasibleRules.map (DefeasibleRule.mapDom f) }

def ModClause.mapDom (f : DomId → DomId) : ModClause → ModClause
  | .conditionedBy ts => .conditionedBy (ts.map (Term.mapDom f))
  | .derivation ds => .derivation (ds.map (Derivation.mapDom f))
  | .postCond es => .postCond (es.map (Effect.mapDom f))
  | .sync ss => .sync (ss.map (Sync.mapDom f))
  | .violation ts => .violation (ts.map (Term.mapDom f))
  | .enforcingActs as => .enforcingActs (as.map f)
  | .terminatedBy as => .terminatedBy (as.map f)
  | .createdBy as => .createdBy (as.map f)
  | .overriddenBy ds => .overriddenBy (ds.map f)
  | .validWhen ts => .validWhen (ts.map (Term.mapDom f))
  | .exceptUnder as => .exceptUnder (as.map f)
  | .against as => .against (as.map f)
  | .unlessCond ts => .unlessCond (ts.map (Term.mapDom f))
  | .dueWithin d => .dueWithin (d.mapDom f)
  | .dueWithinGrace d g => .dueWithinGrace (d.mapDom f) (g.mapDom f)
  | .dueWithinAfter d ev => .dueWithinAfter (d.mapDom f) (ev.mapDom f)
  | .lateWhen ts => .lateWhen (ts.map (Term.mapDom f))
  | .resolves pol t => .resolves pol (t.mapDom f)
  | .decides tgt cnd => .decides (tgt.mapDom f) (cnd.mapDom f)
  | .evEffect op ts src? => .evEffect op (ts.map fun (xs, t) => (xs.map (Var.mapDom f), t.mapDom f)) (src?.map (·.mapDom f))
  | .defeasibleRule r => .defeasibleRule (r.mapDom f)
  | .repeals rs => .repeals (rs.map f)
  | .protects ps => .protects (ps.map f)
  | .excusedWhen ts => .excusedWhen (ts.map (Term.mapDom f))
  | .overridesDuties targets => .overridesDuties (targets.map fun (d, args?) => (f d, args?.map (·.mapDom f)))
  | .decidedBy v wf num den vf => .decidedBy (v.mapDom f) (wf.map f) num den (f vf)
  | .atPos p c => .atPos p (c.mapDom f)
  | c => c

-- Rename the type names a declaration mentions and declares.
mutual
def Decl.mapDom (f : DomId → DomId) : Decl → Decl
  | .atPos p d => .atPos p (d.mapDom f)
  | .typeDecl d t => .typeDecl (f d) (t.mapDom f)
  | .typeExt d cs k => .typeExt (f d) (cs.map (ModClause.mapDom f)) k
  | .placeholder a b => .placeholder (f a) (f b)
  | .param n dom v => .param (f n) dom v
  | .use n args pre sps => .use n (args.map f) pre sps
  | .spanInit t => .spanInit (t.mapDom f)
  | .property tp => .property (tp.mapDom f)
  | .amendInstall a ds => .amendInstall (f a) (Decl.mapDomList f ds)
  | .regime r => .regime { r with params := r.params.map fun (n, v) => (f n, v) }
  | .amendProcedure conds => .amendProcedure (conds.map (Term.mapDom f))
  | .amountDef n dom? e => .amountDef (f n) (dom?.map (·.mapDom f)) (e.mapDom f)
  | .ensureCarrier n dom => .ensureCarrier (f n) (dom.mapDom f)
  | .varInit n e => .varInit (f n) (e.mapDom f)
  | .expose cat ts => .expose cat (ts.map f)
  | .amendMigrate a effs => .amendMigrate (f a) (effs.map (Effect.mapDom f))
  | .actorKey actor pk => .actorKey actor pk
  | d => d

def Decl.mapDomList (f : DomId → DomId) : List Decl → List Decl
  | [] => []
  | d :: ds => d.mapDom f :: Decl.mapDomList f ds
end

/-- The type names a block of declarations introduces (what a `Use` prefixes). -/
def declaredNames (ds : List Decl) : List DomId :=
  ds.filterMap fun raw => match raw.stripPos with
    | .typeDecl d _ => some d
    | .placeholder a _ => some a
    | .param n _ _ => some n
    | .amountDef n _ _ => some n
    | .property tp => some tp.name
    | _ => none

end Charter
