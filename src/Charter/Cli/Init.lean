import Charter.Artifact.Hash
import Lean.Data.Json

/-!
# Charter.Cli.Init — Project Scaffolding, `charter.toml`, `charter.lock`, & UAT (`G5.4`)

`charter init [<dir>]` creates a reproducible, domain-neutral Charter project containing:
- `agreement.md`: authoritative Markdown agreement text;
- `main.charter`: SHA-256 provenance-grounded Charter specification + `Scenario` + `Invariant`;
- `charter.toml`: project manifest (language version, entry program, assurance policy);
- `charter.lock`: deterministic SHA-256 content lockfile over `agreement.md` and `main.charter`;
- `uat/smoke.sh`: executable end-to-end acceptance script.
-/

namespace Charter.Cli

open Lean (Json)

def initCommand (args : List String) : IO UInt32 := do
  let targetDir : System.FilePath := match args with
    | [] => "."
    | [d] => if d.startsWith "-" then "" else d
    | _ => ""
  if targetDir.toString.isEmpty then
    IO.eprintln "usage: charter init [<directory>]"
    return 2
  IO.FS.createDirAll (targetDir / "uat")
  let clauseText := "A steward may release escrowed funds to a beneficiary only when delivery is confirmed."
  let mdContent := "# Escrow Agreement\n\n## E.1 Release Condition\n\n" ++ clauseText ++ "\n"
  let docSha := Artifact.sha256String mdContent
  let clauseSha := Artifact.sha256String clauseText
  let charterContent :=
    "// Generated by `charter init` — run `charter check --require-provenance main.charter` and `charter test main.charter`.\n" ++
    "//! explore: 1\n" ++
    s!"Document MAIN \"agreement.md\" SHA256 \"{docSha}\" Rank 1.\n\n" ++
    s!"Clause E.1 In MAIN Approved \"{clauseSha}\"\n" ++
    s!"  Text \"{clauseText}\"\n" ++
    s!"  Norm \"{clauseText}\" => release-escrow\n" ++
    ".\n\n" ++
    "Fact steward Identified by Steward1.\n" ++
    "Fact beneficiary Identified by Alice.\n" ++
    "Fact delivery-confirmed Identified by beneficiary.\n" ++
    "Fact funds-released Identified by beneficiary.\n\n" ++
    "Power release-escrow Actor steward Recipient beneficiary\n" ++
    s!"  From E.1 \"{clauseText}\"\n" ++
    "  Holds when delivery-confirmed(beneficiary)\n" ++
    "  Valid when delivery-confirmed(beneficiary)\n" ++
    "  Creates funds-released(beneficiary).\n\n" ++
    "Invariant release-requires-delivery\n" ++
    "  When (Forall beneficiary: delivery-confirmed(beneficiary) When funds-released(beneficiary))\n" ++
    s!"  From E.1 \"{clauseText}\".\n\n" ++
    "Scenario release-after-confirmation {\n" ++
    "  ?!valid release-escrow(Steward1, Alice).\n" ++
    "  release-escrow(Steward1, Alice).\n" ++
    "  ?!funds-released(Alice).\n" ++
    "  +delivery-confirmed(Alice).\n" ++
    "  ?valid release-escrow(Steward1, Alice).\n" ++
    "  release-escrow(Steward1, Alice).\n" ++
    "  ?funds-released(Alice).\n" ++
    "}\n"
  let mainSha := Artifact.sha256String charterContent
  let tomlContent :=
    "[package]\n" ++
    "name = \"escrow-institution\"\n" ++
    "version = \"0.1.0\"\n" ++
    "language_version = \"1.0\"\n" ++
    "entry = \"main.charter\"\n\n" ++
    "[assurance]\n" ++
    "require_provenance = true\n" ++
    "deny_warnings = true\n"
  let lockJson := Json.mkObj [
    ("lockVersion", Json.num 1),
    ("files", Json.arr #[
      Json.mkObj [("path", Json.str "agreement.md"), ("sha256", Json.str docSha)],
      Json.mkObj [("path", Json.str "main.charter"), ("sha256", Json.str mainSha)]
    ])
  ]
  let uatScript :=
    "#!/usr/bin/env bash\nset -euo pipefail\ncd \"$(dirname \"$0\")/..\"\n" ++
    "CHARTER_BIN=\"${CHARTER_BIN:-charter}\"\n" ++
    "\"$CHARTER_BIN\" check --require-provenance --deny-warnings main.charter\n" ++
    "\"$CHARTER_BIN\" test --require-provenance --deny-warnings main.charter\n"
  IO.FS.writeFile (targetDir / "agreement.md") mdContent
  IO.FS.writeFile (targetDir / "main.charter") charterContent
  IO.FS.writeFile (targetDir / "charter.toml") tomlContent
  IO.FS.writeFile (targetDir / "charter.lock") (lockJson.pretty ++ "\n")
  IO.FS.writeFile (targetDir / "uat" / "smoke.sh") uatScript
  IO.println s!"initialized Charter project in {targetDir} (agreement.md, main.charter, charter.toml, charter.lock, uat/smoke.sh)"
  return 0

end Charter.Cli
