#!/usr/bin/env bash
# Verification suite runner for Gate G2 (`Verify/Explorer`, `Verify/Reduction`, `Verify/Temporal`, `Verify/Thresholds`).
set -u
cd "$(dirname "$0")/.." || exit 2
B=.lake/build/bin/charter
[ -x "$B" ] || { echo "FAIL verify-check: $B is not built"; exit 2; }
fail=0; pass=0

check_case() { # label, expected_exit, pattern, cmd...
  local label="$1"; local want_st="$2"; local pat="$3"; shift 3
  local out; out=$("$@" 2>&1); local st=$?
  if [ "$st" -eq "$want_st" ] && printf '%s\n' "$out" | grep -qE "$pat"; then
    echo "ok   $label (exit $st)"
    pass=$((pass+1))
  else
    echo "FAIL $label (expected exit $want_st matching '$pat'; got exit $st)"
    printf '%s\n' "$out" | sed 's/^/     /'
    fail=$((fail+1))
  fi
}

# 1. T28: lawful-only explorer sees no counterexample, while adversarial & mixed find 2-step exploit
check_case "t28-lawful-only-safe" 0 "^ok " \
  "$B" explore --mode lawful --depth 3 test/verify/t28_adversarial_unlawful.charter

check_case "t28-adversarial-finds-unlawful-trace" 1 "invariant no-tampered-payout violated in 2 step" \
  "$B" explore --mode adversarial --depth 3 test/verify/t28_adversarial_unlawful.charter

check_case "t28-mixed-adversary-finds-trace" 1 "invariant no-tampered-payout violated in 2 step" \
  "$B" explore --mode mixed --adversary MalHost --depth 3 test/verify/t28_adversarial_unlawful.charter

# 2. T29: open infinite Int parameter on unlawful act without menu returns exit 3 INCONCLUSIVE
check_case "t29-adversarial-missing-menu-inconclusive" 3 "^INCONCLUSIVE" \
  "$B" explore --mode adversarial --depth 2 test/verify/t29_missing_menu_inconclusive.charter

# 3. Safe fenced lease under full adversarial + clock steps passes both finite and inductive
check_case "safe-fenced-lease-adversarial-complete" 0 "^ok " \
  "$B" explore --mode adversarial --depth 3 test/verify/safe_fenced_lease.charter

check_case "safe-fenced-lease-inductive-closed" 0 "^proved " \
  "$B" verify --backend inductive --mode lawful test/verify/safe_fenced_lease.charter

# 4. T26 & T27: partition race without recovery fence caught automatically
check_case "t26-t27-partition-race-caught" 1 "invariant single-authority-fenced violated" \
  "$B" verify --backend finite --mode adversarial --depth 2 test/verify/t26_t27_partition_lease.charter

# 5. T30: a bound smaller than the exploit horizon reports INCONCLUSIVE; depth 2 finds the
#    `10000` threshold trace with no explore-domain menu.
check_case "t30-thresholds-shallow-bound-inconclusive" 3 "^INCONCLUSIVE.*\[thresholds\].*T30" \
  "$B" verify --backend thresholds --depth 1 --min-depth 2 test/verify/t30_threshold_symbolic_int.charter

check_case "t30-thresholds-discovers-threshold-exploit" 1 "\[thresholds\]: invariant cap-preserved violated in 2 step" \
  "$B" verify --backend thresholds --depth 2 test/verify/t30_threshold_symbolic_int.charter

# 5b. D47: there is no solver-backed backend. `--backend smt` and the flags that pretended to
#     drive a solver are usage errors (exit 2), never a fall-through to another search.
check_case "d47-backend-smt-is-not-implemented" 2 "backend smt is not implemented" \
  "$B" verify --backend smt --depth 2 test/verify/t30_threshold_symbolic_int.charter
check_case "d47-solver-flag-is-gone" 2 "unknown flag --solver" \
  "$B" verify --backend thresholds --solver z3 test/verify/t30_threshold_symbolic_int.charter
check_case "d47-emit-smt-flag-is-gone" 2 "unknown flag --emit-smt" \
  "$B" verify --backend thresholds --emit-smt out/_x.smt2 test/verify/t30_threshold_symbolic_int.charter

# 5d. D48 (017.4): a counterexample Quint found is replayed through the evaluator. The trace is
#     Quint's own output on the emitted model (test/verify/replay/); CI regenerates it live
#     (tools/differential-targets-check). A finding is exit 1: a mode in which the evaluator
#     does not offer a step, or a verdict no step reaches. An input that is not a trace of
#     this program's model is exit 2.
RP=test/verify/replay
check_case "d48-replay-quint-counterexample" 0 "^ok .*\[replay\].*3 step\(s\).*both report a violation \(single-authority-fenced\)" \
  "$B" verify --replay "$RP/partition_lease.itf.json" test/verify/t26_t27_partition_lease.charter
check_case "d48-replay-refuses-step-not-offered-in-mode" 1 "^FAIL .*\[replay\].*does not offer in lawful mode" \
  "$B" verify --mode lawful --replay "$RP/partition_lease.itf.json" test/verify/t26_t27_partition_lease.charter
check_case "d48-replay-another-programs-trace-is-an-input-error" 2 "^INPUT .*\[replay\].*not an action of the model" \
  "$B" verify --replay "$RP/partition_lease.itf.json" test/verify/safe_fenced_lease.charter
check_case "d48-replay-refuses-unreached-verdict" 1 "^FAIL .*\[replay\].*the evaluator, after the same 0 step\(s\).*reports none" \
  "$B" verify --replay "$RP/partition_lease_truncated.itf.json" test/verify/t26_t27_partition_lease.charter
check_case "d48-replay-non-trace-is-an-input-error" 2 "^INPUT .*\[replay\].*not a trace this command reads" \
  "$B" verify --replay docs/claims.json test/verify/t26_t27_partition_lease.charter
check_case "d48-replay-missing-trace-is-an-input-error" 2 "^INPUT .*\[replay\].*cannot read" \
  "$B" verify --replay out/_no_such_trace.itf.json test/verify/t26_t27_partition_lease.charter

# 5e. D50 (B38): `verify` no longer accepts the two flags it ignored.
check_case "d50-verify-require-complete-is-gone" 2 "unknown flag --require-complete" \
  "$B" verify --require-complete test/verify/safe_fenced_lease.charter
check_case "d50-explore-require-complete-is-gone" 2 "unknown flag --require-complete" \
  "$B" explore --require-complete test/verify/safe_fenced_lease.charter
check_case "d50-verify-report-assumptions-is-gone" 2 "unknown flag --report-assumptions" \
  "$B" verify --report-assumptions test/verify/safe_fenced_lease.charter

# 5f. D51 (B39): `--invariant` restricts every backend; `--time` outside the inductive backend,
#     the two second spellings, and an unknown flag to `test` are usage errors.
TI=test/verify/d51_two_invariants.charter
check_case "d51-finite-all-invariants-finds-violation" 1 "invariant never-flagged violated" \
  "$B" verify --backend finite --depth 1 "$TI"
check_case "d51-finite-named-invariant-only" 0 "^ok .*\[finite/adversarial\]: 1 invariant\(s\) verified" \
  "$B" verify --backend finite --depth 1 --invariant never-sealed "$TI"
check_case "d51-finite-named-violated-invariant" 1 "invariant never-flagged violated" \
  "$B" verify --backend finite --depth 1 --invariant never-flagged "$TI"
check_case "d51-thresholds-named-invariant-only" 0 "^ok .*\[thresholds\]" \
  "$B" verify --backend thresholds --depth 1 --invariant never-sealed "$TI"
check_case "d51-unknown-invariant" 1 "CHR003: unknown invariant" \
  "$B" verify --backend finite --invariant no-such "$TI"
check_case "d51-time-outside-inductive-is-usage-error" 2 "caps the inductive backend" \
  "$B" verify --backend finite --time 5 "$TI"
check_case "d51-approve-reviewed-is-gone" 2 "unknown flag --reviewed" \
  "$B" approve --reviewed "$TI"
check_case "d51-explore-minimize-is-gone" 2 "unknown flag --minimize" \
  "$B" explore --minimize "$TI"
check_case "d51-test-unknown-flag" 2 "unknown flag --no-such-flag" \
  "$B" test --no-such-flag "$TI"

# 5c. D47: arithmetic that couples two integer variables is outside the threshold fragment
#     and is INCONCLUSIVE, with or without any tool on PATH.
check_case "d47-coupled-arithmetic-inconclusive" 3 "^INCONCLUSIVE.*\[thresholds\].*couples integer variables" \
  "$B" verify --backend thresholds --depth 1 test/verify/d47_coupled_arithmetic.charter

# 6. T31: Unbounded liveness without fairness assumption is INCONCLUSIVE (exit 3)
check_case "t31-unbounded-liveness-requires-fairness" 3 "^INCONCLUSIVE.*T31" \
  "$B" verify --backend finite --depth 2 test/verify/t31_liveness_unfair.charter

# 7. Valid WeakUntil temporal property holds
check_case "t31b-weak-until-holds" 0 "^ok " \
  "$B" verify --backend finite --mode lawful --depth 3 test/verify/t31b_temporal_valid.charter

# 8. T43 (G3.2): Audience-scoped ReasonGraph redaction hides confidential evidence without changing verdict
pub_out=$("$B" explain "release-wire(Off1, Acc1)" test/spec/spec_004_12_reasongraph_redaction.charter --audience public 2>&1); pub_st=$?
if [ "$pub_st" -eq 0 ] && printf '%s\n' "$pub_out" | grep -qE 'lawful=yes.*valid=yes.*redacted=1' \
   && printf '%s\n' "$pub_out" | grep -q '\[REDACTED:' \
   && ! printf '%s\n' "$pub_out" | grep -q 'secret-escrow-bank-ref-991'; then
  echo "ok   t43-explain-public-redacts-confidential-source (exit 0)"
  pass=$((pass+1))
else
  echo "FAIL t43-explain-public-redacts-confidential-source"
  printf '%s\n' "$pub_out" | sed 's/^/     /'
  fail=$((fail+1))
fi

check_case "t43-explain-auditor-authorized-reveals-source" 0 'secret-escrow-bank-ref-991' \
  "$B" explain "release-wire(Off1, Acc1)" test/spec/spec_004_12_reasongraph_redaction.charter --audience auditor

# 9. T38 (G3.5): Semantic rule change under unchanged Clause English flags REVIEW-REQUIRED
tmp_diff=$(mktemp -d)
cat > "$tmp_diff/old.charter" <<'EOF'
Clause C.1 Approved "51513146d67da64faa4a048eb1e2a3882b4e35f8cc850e33e7ab08aab70bf94d"
  Text "A reviewer may grant a license to an eligible applicant."
  Norm "A reviewer may grant a license to an eligible applicant." => grant-license
.
Fact reviewer Identified by Rev1.
Fact applicant Identified by Alice.
Fact eligible Identified by applicant.
Power grant-license Actor reviewer Recipient applicant
  From C.1 "A reviewer may grant a license to an eligible applicant."
  Holds when eligible(applicant)
  Valid when eligible(applicant).
EOF
cat > "$tmp_diff/new.charter" <<'EOF'
Clause C.1 Approved "51513146d67da64faa4a048eb1e2a3882b4e35f8cc850e33e7ab08aab70bf94d"
  Text "A reviewer may grant a license to an eligible applicant."
  Norm "A reviewer may grant a license to an eligible applicant." => grant-license
.
Fact reviewer Identified by Rev1.
Fact applicant Identified by Alice.
Fact eligible Identified by applicant.
Power grant-license Actor reviewer Recipient applicant
  From C.1 "A reviewer may grant a license to an eligible applicant."
  Holds when True
  Valid when True.
EOF
check_case "t38-diff-detects-unreviewed-formal-change" 1 'REVIEW-REQUIRED.*T38' \
  "$B" diff --require-approved "$tmp_diff/old.charter" "$tmp_diff/new.charter"
rm -rf "$tmp_diff"

# 10. #69: Whole-specification analysis (dead rules & unranked overlaps) and claim mutation
check_case "t43-analyze-dead-and-overlap-caught" 1 "CHR047.*unranked-overlap" \
  "$B" analyze test/verify/t43_analyze_dead_and_overlap.charter

check_case "t43b-analyze-clean-passes" 0 "^ok " \
  "$B" analyze test/verify/t43b_analyze_clean.charter

check_case "t44-mutate-claims-catches-vacuous" 1 "survived claim mutation" \
  "$B" test --mutate-claims test/verify/t44_mutate_claims_vacuous.charter

# 11. #75: All-trace inductive linear-arithmetic conservation proofs in the proof kernel (`proved`)
check_case "t45-inductive-arith-conservation-proved" 0 "^proved .*inv-atomic-bounds proved for all traces and parameters" \
  "$B" verify --backend inductive --time 30 test/verify/t45_inductive_arith_conservation.charter

echo "$pass passed, $fail failed, $((pass+fail)) total"
[ $fail -eq 0 ]
