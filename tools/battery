#!/usr/bin/env bash
# PR-tier battery (AGENTS.md "Rebuild and verify"). Run from anywhere:
#
#     tools/battery            full PR tier
#     tools/battery --no-build skip the lake build (the binary must be current)
#
# Exit status is non-zero if any step fails. Each step prints one `ok`/`FAIL` line
# and keeps its full output under out/battery/ for inspection.
set -u
cd "$(dirname "$0")/.." || exit 2
B=.lake/build/bin/charter
OUT=out/battery
mkdir -p "$OUT"
fail=0
build=1
[ "${1:-}" = "--no-build" ] && build=0

step() { # name, status(0/1), detail
  if [ "$2" -eq 0 ]; then printf 'ok    %-28s %s\n' "$1" "$3"; else printf 'FAIL  %-28s %s\n' "$1" "$3"; fail=1; fi
}

# 1. lake build, zero warnings
if [ $build -eq 1 ]; then
  lake build > "$OUT/build.log" 2>&1; st=$?
  warns=$(grep -c 'warning:' "$OUT/build.log")
  if [ $st -ne 0 ]; then step build 1 "lake build failed; see $OUT/build.log"
  elif [ "$warns" -ne 0 ]; then step build 1 "$warns warning(s); see $OUT/build.log"
  else step build 0 "$(tail -1 "$OUT/build.log")"; fi
else
  step build 0 "skipped (--no-build)"
fi
[ -x "$B" ] || { step binary 1 "$B missing"; echo "battery: FAIL"; exit 1; }

# 2. gates
for g in test/gates/*.sh; do
  name=$(basename "$g" .sh)
  bash "$g" > "$OUT/$name.log" 2>&1; st=$?
  step "$name" $st "$(tail -1 "$OUT/$name.log")"
done

# 3. charter check on all neutral in-tree example programs: zero FAIL, zero STALE
EX1=Examples/Tenancy/tenancy.charter
EX2=Examples/AutonomousCommons/commons.charter
EX3=Examples/ServiceEscrow/service-escrow.charter
"$B" check "$EX1" "$EX2" "$EX3" > "$OUT/check-files.log" 2>&1; st=$?
bad=$(grep -cE '^(FAIL|STALE)' "$OUT/check-files.log")
ok=$(grep -c '^ok' "$OUT/check-files.log")
step check-examples $(( st != 0 || bad != 0 )) "$ok ok, $bad FAIL/STALE"

# 4. the eFLINT corpus (D2): every file must agree with eFLINT's recorded outcome,
#    except the tolerated differences, which must differ
BASE=test/eflint-corpus/eflint-outcomes.txt
TOL=test/eflint-corpus/tolerances.md
if [ -f "$BASE" ]; then
  "$B" test test/eflint-corpus/tests test/eflint-corpus/examples --eflint --expect "$BASE" --tolerate "$TOL" > "$OUT/corpus.log" 2>&1; st=$?
else
  "$B" test test/eflint-corpus/tests test/eflint-corpus/examples --eflint --tolerate "$TOL" > "$OUT/corpus.log" 2>&1; st=$?
fi
step eflint-corpus $st "$(tail -1 "$OUT/corpus.log")"

# 5. the spec's conformance tests (plan §5.3)
"$B" test test/spec > "$OUT/spec.log" 2>&1; st=$?
step spec-conformance $st "$(tail -1 "$OUT/spec.log")"

# 6. the standard library (D8, spec 015.5): each lib/ module used by a program, with
#    its invariants checked after every phrase and explored from every end state
"$B" test test/lib > "$OUT/lib.log" 2>&1; st=$?
step standard-library $st "$(tail -1 "$OUT/lib.log")"

# 7. charter prove on the kernel fixtures (spec 013.4): every claim and invariant decided
#    by the kernel, the false claims reported as failed; programs that decide in seconds
tools/prove-check test/prove > "$OUT/prove.log" 2>&1; st=$?
step prove $st "$(tail -1 "$OUT/prove.log")"

# 8. the neutral example programs written in Charter: tenancy, commons (over the eight lib/
#    modules), and service-escrow; `test` runs their scenarios, explores their invariants,
#    and verifies all Law 8 provenance checks
"$B" test "$EX1" "$EX2" "$EX3" > "$OUT/examples.log" 2>&1; st=$?
step examples $st "$(tail -1 "$OUT/examples.log")"

if [ $fail -eq 0 ]; then echo "battery: PASS"; else echo "battery: FAIL"; fi
exit $fail
