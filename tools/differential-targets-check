#!/usr/bin/env bash
# Differential & Law-10 Assurance Check for Emitted Targets (`D42`, `#66`, `Law 9`, `Law 10`):
# - Always checks strict Law-10 assurance metadata (`proved` vs `checked` vs `advisoryOnly`),
#   real compiled Solidity guard predicates & storage writes, and 3-way `SolidityIR`/`GuardIR`/`Eval` parity.
# - With `solc`, `forge`, and `quint` installed: compiles the emitted `.sol` with `solc`, runs a
#   Foundry EVM differential trace test, typechecks the emitted `.qnt` models with `quint` and
#   requires its simulator to reach the same verdict as Charter on each. No SMT solver is run:
#   Charter has no solver-backed backend (`D47`).
# - A tool that is not installed is never skipped quietly: each missing one prints a `SKIP` line
#   and the last line names them. Under `--require-external-tools` (or
#   `CHARTER_REQUIRE_EXTERNAL_TOOLS=1`, which CI sets) a missing tool is a failure.
set -euo pipefail
cd "$(dirname "$0")/.."

B=".lake/build/bin/charter"
[ -x "$B" ] || { echo "FAIL differential-targets-check: $B missing"; exit 2; }

require_ext=0
[ "${1:-}" = "--require-external-tools" ] && require_ext=1
[ "${CHARTER_REQUIRE_EXTERNAL_TOOLS:-0}" = "1" ] && require_ext=1

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
skipped=""

missing() { # tool: a failure when the tools are required, a named SKIP otherwise
  if [ "$require_ext" -eq 1 ]; then
    echo "FAIL differential-targets-check: $1 is required (--require-external-tools) and is not installed"
    exit 1
  fi
  echo "SKIP $1: not installed, so its checks did not run"
  skipped="$skipped $1"
}

# 1. Verify strict Law-10 JSON tags on all three targets (never a 5th tag!)
"$B" generate --target solidity --verify-output --out json -o "$tmp/sol.json" test/verify/safe_fenced_lease.charter >/dev/null
"$B" generate --target quint --mode adversarial --verify-output --out json -o "$tmp/qnt.json" test/verify/safe_fenced_lease.charter >/dev/null
"$B" generate --target prompt --actor accountant --out json -o "$tmp/prm.json" Examples/TreasuryMandate/treasury-mandate.charter >/dev/null
"$B" generate --target solidity --verify-output -o "$tmp/SafeFencedLease.sol" test/verify/safe_fenced_lease.charter >/dev/null

python3 -I - "$tmp" <<'PY'
import json, pathlib, sys

tmp = pathlib.Path(sys.argv[1])
valid_law10 = {"proved", "decided", "checked", "assumed"}

sol_meta = json.loads((tmp / "sol.json").read_text(encoding="utf-8"))
assert sol_meta["irAssurance"] == "proved" and sol_meta["irAssurance"] in valid_law10
assert sol_meta["surfaceAssurance"] == "checked" and sol_meta["surfaceAssurance"] in valid_law10

qnt_meta = json.loads((tmp / "qnt.json").read_text(encoding="utf-8"))
assert qnt_meta["surfaceAssurance"] == "checked" and qnt_meta["surfaceAssurance"] in valid_law10
qnt_src = qnt_meta["quint"]
assert "held_active_lease.union(Set((p1_node, p0_host)))" in qnt_src, "expected the grant-lease effect in the Quint model"
assert "clock_now + 3" in qnt_src, "expected the half-open expiry write in the Quint model"
assert "live_active_lease((p1_node, \"H1\"))" in qnt_src, "expected the compiled `Valid when` guard in the Quint model"

prm_meta = json.loads((tmp / "prm.json").read_text(encoding="utf-8"))
assert prm_meta["authoritative"] is False

sol_src = (tmp / "SafeFencedLease.sol").read_text(encoding="utf-8")
assert "_factLive_active_lease" in sol_src, "expected compiled active_lease guard predicate in Solidity"
assert "factExpiry_active_lease" in sol_src, "expected compiled half-open expiry storage write in Solidity"
assert 'require((false || false), "CharterGuard: guard rejected")' in sol_src, "expected unlawful-cut-link guard rejection"
PY
echo "ok   law10-target-tags-and-compiled-solidity-predicates"

# 2. External tool differential checks (`solc`, `forge`, `quint`)
if command -v solc >/dev/null 2>&1; then
  solc --bin --abi "$tmp/SafeFencedLease.sol" -o "$tmp/solc_out" >/dev/null
  echo "ok   solc-bytecode-and-abi-compiled"
else
  missing solc
fi

if command -v forge >/dev/null 2>&1; then
  mkdir -p "$tmp/foundry/src" "$tmp/foundry/test"
  cp "$tmp/SafeFencedLease.sol" "$tmp/foundry/src/SafeFencedLease.sol"
  cat > "$tmp/foundry/foundry.toml" <<'TOML'
[profile.default]
src = "src"
out = "out"
libs = []
solc_version = "0.8.24"
TOML
  cat > "$tmp/foundry/test/DifferentialGuard.t.sol" <<'SOL'
// SPDX-License-Identifier: Apache-2.0
pragma solidity ^0.8.24;
import "../src/SafeFencedLease.sol";

contract DifferentialGuardTest {
    function testDifferentialTrace() public {
        safe_fenced_leaseGuard g = new safe_fenced_leaseGuard();
        bytes32 h1 = keccak256(bytes("H1"));
        bytes32 h2 = keccak256(bytes("H2"));
        bytes32 n1 = keccak256(bytes("N1"));

        // 1. Unlawful action must revert on chain (matches Charter.Eval Allow=no)
        (bool okCut, ) = address(g).call(abi.encodeWithSelector(g.guard_unlawful_cut_link.selector, h1));
        require(!okCut, "unlawful-cut-link must revert");

        // 2. First lease grant (H1, N1) succeeds
        bool allowed1 = g.guard_grant_lease(h1, n1);
        require(allowed1 && g.stateVersion() == 1, "first grant-lease must succeed");

        // 3. Conflicting second lease grant (H2, N1) before expiry must revert
        (bool okSecond, ) = address(g).call(abi.encodeWithSelector(g.guard_grant_lease.selector, h2, n1));
        require(!okSecond, "conflicting grant-lease must revert while lease is live");
    }
}
SOL
  (cd "$tmp/foundry" && forge test -vv >/dev/null)
  echo "ok   foundry-evm-differential-trace"
else
  missing forge
fi

# The emitted Quint models must typecheck, and Quint's own simulator must reach the verdict
# Charter reaches on each: no violation where Charter's explorer is safe, a violation of the
# invariant where it finds a counterexample (`T32`).
quint_verdict() { # label, mode, want (safe|violated), file
  local label="$1" mode="$2" want="$3" file="$4"
  local qnt="$tmp/$label.qnt"
  "$B" generate --target quint --mode "$mode" --verify-output -o "$qnt" "$file" >/dev/null
  quint typecheck "$qnt" >/dev/null
  local out st=0
  out=$(quint run "$qnt" --backend=typescript --seed=0x1 --invariant=charter_invariants \
          --max-steps=3 --max-samples=2000 2>&1) || st=$?
  if [ "$want" = safe ] && [ "$st" -eq 0 ] && printf '%s\n' "$out" | grep -q 'No violation found'; then return 0; fi
  if [ "$want" = violated ] && [ "$st" -ne 0 ] && printf '%s\n' "$out" | grep -q 'Invariant violated'; then
    # 017.4 (`D48`): the counterexample Quint found on the emitted text is performed through
    # the evaluator, which must report a violation at its end too.
    local itf="$tmp/$label.itf.json" rout rst=0 qst=0
    # quint exits non-zero because it found the violation; what must exist is the trace
    quint run "$qnt" --backend=typescript --seed=0x1 --invariant=charter_invariants \
      --max-steps=3 --max-samples=2000 --mbt --out-itf="$itf" >/dev/null 2>&1 || qst=$?
    if [ "$qst" -eq 0 ] || [ ! -s "$itf" ]; then
      echo "FAIL quint-trace-replay $label [$mode]: quint exited $qst and wrote no counterexample trace"
      exit 1
    fi
    rout=$("$B" verify --mode "$mode" --replay "$itf" "$file" 2>&1) || rst=$?
    if [ "$rst" -eq 0 ] && printf '%s\n' "$rout" | grep -q 'both report a violation'; then return 0; fi
    echo "FAIL quint-trace-replay $label [$mode]: Quint's counterexample does not replay through the evaluator (exit $rst):"
    printf '%s\n' "$rout" | sed 's/^/     /'
    exit 1
  fi
  echo "FAIL quint-verdict $label [$mode]: Charter says $want, quint exited $st with:"
  printf '%s\n' "$out" | tail -20 | sed 's/^/     /'
  exit 1
}

if command -v quint >/dev/null 2>&1; then
  quint_verdict safe_lease_adversarial adversarial safe     test/verify/safe_fenced_lease.charter
  quint_verdict safe_lease_lawful      lawful      safe     test/verify/safe_fenced_lease.charter
  quint_verdict partition_lease        adversarial violated test/verify/t26_t27_partition_lease.charter
  quint_verdict booking_adversarial    adversarial violated test/verify/quint_booking_effects.charter
  quint_verdict booking_lawful         lawful      safe     test/verify/quint_booking_effects.charter
  echo "ok   quint-typechecks-and-simulator-verdicts-match (5 models; 2 counterexamples replayed through the evaluator)"
else
  missing quint
fi

if [ -n "$skipped" ]; then
  echo "external tools not installed, checks SKIPPED:$skipped"
else
  echo "external tools: all three ran"
fi
