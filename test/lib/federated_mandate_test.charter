// test/lib/federated_mandate_test.charter — Exercises D43 confidential forwarding leak
// detection/slashing, leaked-statement nullity, granular revocation isolation, and
// notice-gated affirmative deadlines.
//! explore: 1
#require "../../lib/federated_mandate.charter".

Fact org Identified by ClinicA, PartnerLab, ThirdParty.
Fact stmt-id Identified by StmtConsent, StmtAux.
Fact req-id Identified by AuditReq1.

Use federated-mandate(org, stmt-id, req-id) As fm.

Scenario confidential-leak-caught-slashed-and-unusable {
  fm-issue-confidential-statement(ClinicA, PartnerLab, StmtConsent).
  fm-issue-confidential-statement(ClinicA, PartnerLab, StmtAux).

  // Authorized recipient PartnerLab can validly rely on StmtConsent:
  ?valid fm-rely-on-statement(PartnerLab, StmtConsent).
  fm-rely-on-statement(PartnerLab, StmtConsent).
  ?fm-relied-on(PartnerLab, StmtConsent).

  // PartnerLab forwards StmtConsent to unauthorized ThirdParty (`Law 1`: physical forward occurs):
  fm-forward-statement(PartnerLab, ThirdParty, StmtConsent).
  ?fm-possesses-statement(StmtConsent, ThirdParty).
  ?fm-leaked-by(StmtConsent, PartnerLab, ThirdParty).
  ?violated fm-guard-confidential-statement(PartnerLab, ClinicA, StmtConsent).

  // ThirdParty possesses the leaked statement, yet reliance by ThirdParty is void (`?!valid`):
  ?!valid fm-rely-on-statement(ThirdParty, StmtConsent).
  fm-rely-on-statement(ThirdParty, StmtConsent).
  ?!fm-relied-on(ThirdParty, StmtConsent).

  // ClinicA slashes PartnerLab's bond and revokes StmtConsent while StmtAux stays active:
  fm-slash-leak-bond(ClinicA, PartnerLab, StmtConsent).
  ?fm-bond-slashed(PartnerLab, StmtConsent).
  fm-revoke-statement(ClinicA, StmtConsent).
  ?!valid fm-rely-on-statement(PartnerLab, StmtConsent).
  ?valid fm-rely-on-statement(PartnerLab, StmtAux).
}

Scenario unnotified-demand-never-breaches-before-notice {
  fm-issue-demand(ClinicA, PartnerLab, AuditReq1).
  ?fm-satisfy-demand(PartnerLab, ClinicA, AuditReq1).

  // Advance clock far past nominal 5-unit response-window WITHOUT delivering notice:
  @ 20.
  ?!violated fm-satisfy-demand(PartnerLab, ClinicA, AuditReq1).

  // Deliver notice at t=20: deadline runs 5 units from notice (t=25), not from t=0:
  fm-deliver-demand-notice(ClinicA, PartnerLab, AuditReq1).
  @ 24.
  ?!violated fm-satisfy-demand(PartnerLab, ClinicA, AuditReq1).
  @ 25.
  ?violated fm-satisfy-demand(PartnerLab, ClinicA, AuditReq1).
  fm-fulfill-demand(PartnerLab, AuditReq1).
  ?!fm-satisfy-demand(PartnerLab, ClinicA, AuditReq1).
}
