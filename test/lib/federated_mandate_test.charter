// test/lib/federated_mandate_test.charter — Exercises D43 confidential forwarding leak
// detection/slashing, leaked-statement nullity, granular revocation isolation, and
// notice-gated affirmative deadlines.
//! explore: 1
#require "../../lib/federated_mandate.charter".

Fact org Identified by StAntonius, SURF, Dan.
Fact stmt-id Identified by StmtConsent, StmtAux.
Fact req-id Identified by AuditReq1.

Use federated-mandate(org, stmt-id, req-id) As fm.

Scenario confidential-leak-caught-slashed-and-unusable {
  fm-issue-confidential-statement(StAntonius, SURF, StmtConsent).
  fm-issue-confidential-statement(StAntonius, SURF, StmtAux).

  // Authorized recipient SURF can validly rely on StmtConsent:
  ?valid fm-rely-on-statement(SURF, StmtConsent).
  fm-rely-on-statement(SURF, StmtConsent).
  ?fm-relied-on(SURF, StmtConsent).

  // SURF forwards StmtConsent to unauthorized Dan (`Law 1`: physical forward occurs!):
  fm-forward-statement(SURF, Dan, StmtConsent).
  ?fm-possesses-statement(StmtConsent, Dan).
  ?fm-leaked-by(StmtConsent, SURF, Dan).
  ?violated fm-guard-confidential-statement(SURF, StAntonius, StmtConsent).

  // Dan possesses the leaked statement, yet reliance by Dan is void (`?!valid`):
  ?!valid fm-rely-on-statement(Dan, StmtConsent).
  fm-rely-on-statement(Dan, StmtConsent).
  ?!fm-relied-on(Dan, StmtConsent).

  // St. Antonius slashes SURF's bond and revokes StmtConsent while StmtAux stays active:
  fm-slash-leak-bond(StAntonius, SURF, StmtConsent).
  ?fm-bond-slashed(SURF, StmtConsent).
  fm-revoke-statement(StAntonius, StmtConsent).
  ?!valid fm-rely-on-statement(SURF, StmtConsent).
  ?valid fm-rely-on-statement(SURF, StmtAux).
}

Scenario unnotified-demand-never-breaches-before-notice {
  fm-issue-demand(StAntonius, SURF, AuditReq1).
  ?fm-satisfy-demand(SURF, StAntonius, AuditReq1).

  // Advance clock far past nominal 5-unit response-window WITHOUT delivering notice:
  @ 20.
  ?!violated fm-satisfy-demand(SURF, StAntonius, AuditReq1).

  // Deliver notice at t=20: deadline runs 5 units from notice (t=25), not from t=0!
  fm-deliver-demand-notice(StAntonius, SURF, AuditReq1).
  @ 24.
  ?!violated fm-satisfy-demand(SURF, StAntonius, AuditReq1).
  @ 25.
  ?violated fm-satisfy-demand(SURF, StAntonius, AuditReq1).
  fm-fulfill-demand(SURF, AuditReq1).
  ?!fm-satisfy-demand(SURF, StAntonius, AuditReq1).
}
