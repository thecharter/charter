// Everyday standard-library modules (`debt`, `ballot`, `succession`) instantiated under
// `--require-provenance` via `Use ... From <CLAUSE>` and `Money(USD, 2)` (`D34`, `#62`).
//! require-provenance
#require "../../lib/debt.charter".
#require "../../lib/ballot.charter".
#require "../../lib/succession.charter".

Document "../spec/include/byref_doc.md"

Fact member Identified by Alice, Bob, Carol
Fact invoice Identified by Inv1
Fact motion Identified by BudgetVote
Fact seat Identified by Chair
Fact usd Identified by Money(USD, 2)

Clause 1.1 Approved "a83478129c1d2d3880a6b3d7aa9aecc9057f815411df5244edcc1aba5b1d3680" Definition
Clause 1.2/1 Approved "3afb3b028233a24ca1fa6984c2bddae1a561b94cfb6d322e2cf7efd7f664fd71"
Clause 1.2/2 Approved "b576c1b03bd41c4e7217b5c2038a0c74173c78d39f3f315e8c2d32dde86ad092"
Clause 1.3 Approved "469ec0b1f9888d3dfb5ce1f0622e318f1a7e8f4508faa0081c9e487eba8dfe61"

Use debt-obligation(member, member, invoice, usd) As d From 1.2/1
Use weighted-ballot(motion, member) As b From 1.2/2
Use role-succession(seat, member) As s From 1.3
.
+b-eligible-voter(Alice). +b-eligible-voter(Bob). +b-eligible-voter(Carol).
+b-voter-weight(Alice, 50). +b-voter-weight(Bob, 30). +b-voter-weight(Carol, 20).
+s-primary-for(Chair, Alice). +s-alternate-for(Chair, Bob).

Scenario partial-payment-and-discharge {
  d-incur-debt(Bob, Alice, Inv1, 10000).
  ?d-payment-due(Alice, Bob, Inv1).
  d-pay-debt(Alice, Bob, Inv1, 4000).
  ?d-remaining(Inv1, 6000).
  ?d-payment-due(Alice, Bob, Inv1).
  d-pay-debt(Alice, Bob, Inv1, 6000).
  ?d-remaining(Inv1, 0).
  ?!d-payment-due(Alice, Bob, Inv1).
}

Scenario weighted-vote-and-succession {
  ?s-acting-holder(Chair, Alice).
  s-mark-unavailable(Alice).
  ?!s-acting-holder(Chair, Alice).
  ?s-acting-holder(Chair, Bob).

  b-open-ballot(Bob, BudgetVote).
  b-cast-yes(Alice, BudgetVote).
  ?!b-carried-majority(BudgetVote).
  b-cast-yes(Carol, BudgetVote).
  ?b-carried-majority(BudgetVote).
  ?b-carried-two-thirds(BudgetVote).
}
