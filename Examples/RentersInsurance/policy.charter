// A renters insurance policy between Harbor Mutual and Nora Quinn (policy.md).
Document "policy.md".

Role insurer Is HarborMutual
Role insured Is Nora
Fact party Identified by HarborMutual, Nora
Role adjuster Is Ines
Param premium = $20.00
Param deductible = $500.00
Param limit = $20,000.00

// R.1 The policy: in force until cancelled; a loss is in the policy if it happens meanwhile
Bool cancellation-noticed
Bool in-force
  Holds when !Held(cancellation-noticed) For 10
Fact loss
Fact in-policy Identified by loss
Event loss-happens Related to loss
  Creates loss, notice-due(insured, insurer, loss)
        , in-policy(loss) When in-force

// R.2 Premium
Event month-begins
  Creates premium-due(insured, insurer) When in-force
Duty premium-due Holder insured Claimant insurer
  Due within 1 day
  Terminated by pay-premium
Act pay-premium Actor insured Recipient insurer Related to amount : USD
  Valid when amount >= premium
  Terminates cancellation-noticed When in-force

// R.3 What is covered; R.4 What is not covered
Fact cause Identified by Theft, Fire, Flood, OwnAct, Wear
Evidenced Fact caused-by Identified by loss * cause
Fact covered Identified by loss
  Default theft-or-fire
    Holds when in-policy(loss) && (Established(caused-by(loss, Theft)) || Established(caused-by(loss, Fire)))
  Exception flood Overrides theft-or-fire Rejects when Established(caused-by(loss, Flood))
  Exception on-purpose Overrides theft-or-fire Rejects when Established(caused-by(loss, OwnAct))
  Exception ordinary-wear Overrides theft-or-fire Rejects when Established(caused-by(loss, Wear))
  Exception late-notice Overrides theft-or-fire Rejects when !noticed(loss)
  Exception cause-in-dispute Overrides theft-or-fire
    Rejects when (Exists cause: Conflicted(caused-by(loss, cause)))

// R.5 Limit and deductible
Function value Identified by loss * amount : USD
Function payable Identified by loss * amount : USD
  Derived from payable(value.loss, Min(value.amount - deductible, limit))
                 When covered(value.loss) && value.amount > deductible

// R.6 Notice and proof of loss
Duty notice-due Holder insured Claimant insurer Related to loss
  Due within 30 days
  Terminated by give-notice
Fact noticed Identified by loss
Act give-notice Actor insured Recipient insurer Related to loss
  Valid when !Violated(notice-due(insured, insurer, loss))
  Creates noticed(loss)
Fact stated Identified by party * loss * cause
Act prove-loss Actor insured Recipient insurer Related to loss, cause, amount : USD
  Holds when noticed(loss)
  Supports caused-by(loss, cause)
  Creates value(loss, amount), stated(Nora, loss, cause)

// R.7 Payment
Duty claim-due Holder insurer Claimant insured Related to loss
  Holds when (Exists payable: payable.loss == loss)
  Due within 30 days
  Terminated by pay-claim
Act pay-claim Actor insurer Recipient insured Related to loss, amount : USD
  Valid when payable(loss) == amount

// R.8 Disputed cause
Act state-cause Actor insurer Recipient insured Related to loss, cause
  Holds when True
  Supports caused-by(loss, cause)
  Creates stated(HarborMutual, loss, cause)
Act dispute-cause Actor party Related to loss, cause
  Holds when (Exists party': party' != party && stated(party', loss, cause))
  Rebuts caused-by(loss, cause)
Fact answer Identified by Yes, No
Finding decide-cause Actor adjuster Related to loss, cause, answer
  Decides caused-by(loss, cause) When answer == Yes
  Valid when Conflicted(caused-by(loss, cause))

// R.9 Cancellation
Power give-cancellation-notice Actor insurer Recipient insured
  Valid when Violated(premium-due(Nora, HarborMutual))
  Creates cancellation-noticed

Clause R.1/1 Definition => insurer, insured
Clause R.1/2 => in-force, loss-happens, in-policy
Clause R.2 => premium, month-begins, premium-due, pay-premium
Clause R.3 => theft-or-fire, covered
Clause R.4 => flood, on-purpose, ordinary-wear
Clause R.5 => deductible, limit, payable
Clause R.6/1 => notice-due, give-notice
Clause R.6/2 => late-notice, give-notice
Clause R.6/3 => prove-loss, value
Clause R.7 => claim-due, pay-claim
Clause R.8/1 => state-cause, dispute-cause
Clause R.8/2 => adjuster, decide-cause
Clause R.8/3 => cause-in-dispute, claim-due
Clause R.9/1 => give-cancellation-notice
Clause R.9/2 => in-force, pay-premium
Clause R.9/3 => give-cancellation-notice.
