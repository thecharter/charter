// Victor Lang's guaranty of Dana Cole's loan from Ines Marlow (guaranty.md).
Document "guaranty.md".

Role lender Is Ines
Role borrower Is Dana
Role guarantor Is Victor
Param loan = $8,000.00
Param limit = $5,000.00
Param term : Duration = 90
Param notice-window : Duration = 30

// 1.1 The loan, and default on it
Var balance : USD = loan
Duty repay Holder borrower Claimant lender
  Holds when balance > $0
  Due within term
Act pay-loan Actor borrower Recipient lender Related to amount : USD
  Holds when amount <= balance
  Creates balance(balance - amount)
Bool in-default Holds when Violated(repay(Dana, Ines))

// 3. Notice of default, within thirty days
Bool notified
Duty notice-due Holder lender Claimant guarantor
  Holds when in-default && !notified
  Violated when Held(repay(Dana, Ines)) For term + notice-window
Power give-notice Actor lender Recipient guarantor
  Holds when True
  Valid when notice-due(Ines, Victor) && !Violated(notice-due(Ines, Victor))
  Creates notified

// 1.2 and 2. Demand, within the limit, and payment in fifteen days
Var called : USD = $0
Var unpaid : USD = $0
Power demand Actor lender Recipient guarantor Related to amount : USD
  Valid when in-default && notified && called + amount <= limit && unpaid + amount <= balance
  Creates called(called + amount), unpaid(unpaid + amount)
Duty guaranty-due Holder guarantor Claimant lender
  Holds when unpaid > $0
  Due within 15 days

// 5. The guarantor who pays takes over the claim
Var claim : USD = $0
Act pay-guaranty Actor guarantor Recipient lender Related to amount : USD
  Holds when amount <= unpaid
  Creates unpaid(unpaid - amount), balance(balance - amount), claim(claim + amount)
Duty reimburse Holder borrower Claimant guarantor
  Holds when claim > $0
Act repay-guarantor Actor borrower Recipient guarantor Related to amount : USD
  Holds when amount <= claim
  Creates claim(claim - amount)

// 4. A change without consent releases the guarantor
Bool consent
Act consent-to-change Actor guarantor Recipient lender
  Holds when True
  Creates consent
Act change-terms Actor lender Recipient borrower
  Holds when consent
  Creates released(guarantor) When !consent
  Terminates consent
Immunity released Holder guarantor Against demand

Clause 1.1/1 Definition => lender, borrower, guarantor, loan
Clause 1.1/2 => term, repay, pay-loan, in-default
Clause 1.2/1 => demand
Clause 1.2/2 => guaranty-due, pay-guaranty
Clause 2.1 => limit, demand
Clause 3.1/1 => notice-window, notice-due, give-notice
Clause 3.1/2 => demand, give-notice
Clause 4.1/1 => change-terms, consent-to-change
Clause 4.1/2 => released, change-terms
Clause 5.1 => pay-guaranty, reimburse, repay-guarantor.
