// Dana's loan: $8,000.00 owed to Ines on day 0, due by day 90; Victor's limit is $5,000.00.
#require "../guaranty.charter".

Scenario the-guarantor-pays-and-takes-over-the-claim {
  @ 90.
  ?in-default.
  give-notice().
  demand($3,000.00).
  ?guaranty-due().
  @ 104.
  ?!violated guaranty-due().
  @ 105.
  ?violated guaranty-due().
  pay-guaranty($3,000.00).
  ?!guaranty-due().
  ?balance($5,000.00). ?claim($3,000.00).        // Dana owes Ines $3,000.00 less, and owes it to Victor
  ?reimburse().
  repay-guarantor($3,000.00).
  ?!reimburse().
}

Scenario no-default-no-duty {
  ?!guaranty-due().
  @ 89.
  ?!in-default.
  ?!lawful demand($3,000.00). ?!valid demand($3,000.00).
  demand($3,000.00).                             // the lender asks anyway
  ?!guaranty-due(). ?called($0).
  pay-loan($8,000.00).
  @ 90.
  ?!in-default. ?!notice-due().
}

Scenario five-thousand-dollars-in-all {
  @ 90.
  give-notice().
  demand($3,000.00).
  ?!valid demand($3,000.00).                     // $6,000.00 in all
  demand($3,000.00).
  ?unpaid($3,000.00).
  ?valid demand($2,000.00).
  demand($2,000.00).
  pay-guaranty($5,000.00).
  ?balance($3,000.00).
  ?!valid demand($0.01).                         // the limit is spent though Dana still owes $3,000.00
}

Scenario no-more-than-the-borrower-owes {
  pay-loan($7,000.00).
  @ 90.
  give-notice().
  ?!valid demand($2,000.00).
  ?valid demand($1,000.00).
}

Scenario notice-thirty-one-days-after-the-default {
  @ 90.
  ?notice-due().
  ?!valid demand($3,000.00).                     // no notice yet
  @ 119.
  ?valid give-notice().
  @ 120.
  ?violated notice-due().
  ?!valid give-notice().
  give-notice().
  ?!notified. ?!valid demand($3,000.00).
}

Scenario a-change-without-consent-releases-the-guarantor {
  ?!lawful change-terms().
  change-terms().                                // a breach, and it has its effect
  ?released(Victor).
  @ 90.
  give-notice().
  ?!valid demand($3,000.00).
  demand($3,000.00).
  ?!guaranty-due(). ?called($0).
}

Scenario a-change-the-guarantor-agreed-to {
  consent-to-change().
  ?lawful change-terms().
  change-terms().
  ?!released(Victor).
  ?!lawful change-terms().                       // one consent, one change
  @ 90.
  give-notice().
  ?valid demand($3,000.00).
}

Scenario a-demand-made-before-the-change-stands {
  @ 90.
  give-notice().
  demand($3,000.00).
  change-terms().
  ?released(Victor).
  ?guaranty-due().
  ?!valid demand($1,000.00).
}
