// Elena's loan: $10,000.00 lent on day 0; an instalment of $860.66 every thirty days.
#require "../note.charter".
lend().

Scenario paid-on-the-day-every-time {
  ?owing($10,000.00). ?!instalment-due(1).
  @ 30.
  ?instalment-due(1). ?interest-owing($50.00).                // a twelfth of 6% of $10,000.00
  pay($860.66).
  ?principal($9,189.34). ?interest-owing($0). ?!instalment-due(1).
  @ 60.
  ?interest-owing($45.95).                                    // on $9,189.34, not on $10,000.00
  pay($860.66).
  ?principal($8,374.63).
  @ 90. pay($860.66).
  @ 120. pay($860.66).
  @ 150. pay($860.66).
  @ 180. pay($860.66).
  @ 210. pay($860.66).
  @ 240. pay($860.66).
  @ 270. pay($860.66).
  @ 300. pay($860.66).
  @ 330. pay($860.66).
  ?principal($856.42).
  @ 360.
  ?owing($860.70).                                            // the twelfth is four cents more
  ?!lawful pay($860.71).
  pay($860.66).
  ?instalment-due(12).                                        // a regular instalment does not clear it
  pay($0.04).
  ?owing($0). ?!instalment-due(12). ?!late(12).
}

Scenario ten-days-of-grace {
  @ 30.
  ?instalment-due(1).
  @ 39.
  ?!violated instalment-due(1). ?fees-owing($0).
  @ 40.
  ?violated instalment-due(1). ?late(1). ?fees-owing($43.03). // 5% of $860.66
}

Scenario a-late-instalment-stays-late-and-its-fee-is-paid-first {
  @ 30. @ 45.
  ?owing($10,093.03).                                         // principal, $50.00 interest, $43.03 fee
  pay($20.00).
  ?fees-owing($23.03). ?interest-owing($50.00). ?principal($10,000.00).
  pay($840.66).
  ?fees-owing($0). ?interest-owing($0). ?principal($9,232.37). // $860.66 less the fee and the interest
  ?late(1). ?!instalment-due(1).
}

Scenario paying-ahead-costs-nothing-and-covers-the-next-instalments {
  @ 10.
  pay($3,000.00).
  ?!lawful charge-for-early-payment().
  charge-for-early-payment().                                 // a breach, and it adds nothing
  ?principal($7,000.00). ?fees-owing($0). ?owing($7,000.00).
  @ 30.
  ?interest-owing($35.00).                                    // on the $7,000.00 still unpaid
  ?!instalment-due(1).
  @ 90.
  ?!instalment-due(3).                                        // $3,000.00 covers three instalments
  @ 120.
  ?instalment-due(4).
}

Scenario paid-off-in-one-go {
  @ 45.
  ?owing($10,093.03).
  pay($10,093.03).
  ?owing($0). ?principal($0).
  @ 360.
  ?owing($0). ?!instalment-due(12).
}

Scenario thirty-days-of-default-and-the-loan-is-called-in {
  @ 30. @ 59.
  ?!valid call-in().
  call-in().
  ?!called-in. ?!everything-due().                            // a notice a day early does nothing
  @ 60.
  ?valid call-in().
  call-in().
  ?violated everything-due().
  ?interest-owing($100.00).                                   // simple: $50.00 twice, not $50.00 then $50.25
  ?owing($10,143.03).
  pay($10,143.03).
  ?!everything-due(). ?principal($0).
}

Scenario no-default-no-call {
  @ 30. pay($860.66).
  @ 60. @ 89.
  ?!valid call-in().                                          // the second instalment is 29 days old
  @ 90.
  ?valid call-in().
}
