// A promissory note from Elena Brooks to Marcus Dunn (note.md).
Document "note.md".

Role lender Is Marcus
Role borrower Is Elena
Fact instalment Identified by 1..12
Param loan = $10,000.00
Param regular = $860.66
Param period : Duration = 30
Param grace : Duration = 10
Param default-after : Duration = 30

// 1. The loan
Bool lent
Var principal : USD
Act lend Actor lender Recipient borrower
  Holds when !lent
  Creates lent, principal(loan), interest($0), charged(0), paid($0), fees-paid($0)

// 2. Interest: a twelfth of six percent (50 bps) of the unpaid principal every thirty days
Fact fallen-due Identified by instalment
  Holds when Held(lent) For period * instalment
Var interest : USD
Var charged : Int
Amount interest-owing : USD Is
  interest + MulDivRound(principal, 50 bps, NearestEven) * (Count(fallen-due) - charged)

// 3. Instalments, and 6.1: money paid ahead counts toward the next ones
Var paid : USD
Fact covered Identified by instalment
  Holds when instalment < 12 && paid >= regular * instalment
  Holds when principal == $0
Duty instalment-due Holder borrower Claimant lender Related to instalment
  Holds when fallen-due(instalment) && !covered(instalment)
  Violated when Held(lent) For period * instalment + grace

// 4. Late fee: five percent of a regular instalment for each late instalment
Fact late Identified by instalment
  Holds when Violated(instalment-due(Elena, Marcus, instalment))
Var fees-paid : USD
Amount fees-owing : USD Is
  MulDivRound(regular, 5%, NearestEven) * Count(late) - fees-paid
Amount owing : USD Is fees-owing + interest-owing + principal

// 5 and 6. Payment, at any time, applied first to fees, then interest, then principal
Act pay Actor borrower Recipient lender Related to amount : USD
  Holds when lent && amount <= owing
  Creates paid(paid + amount)
        , charged(Count(fallen-due))
        , (Foreach instalment: late(instalment) When Violated(instalment-due(Elena, Marcus, instalment)))
        , fees-paid(fees-paid + Min(amount, fees-owing))
        , interest(If(amount <= fees-owing, interest-owing, Max($0, fees-owing + interest-owing - amount)))
        , principal(Min(principal, owing - amount))
Prohibited charge-for-early-payment Actor lender Recipient borrower

// 7. Default: thirty days unpaid, then the lender may call in everything
Bool called-in
Power call-in Actor lender Recipient borrower
  Holds when True
  Valid when (Exists instalment: instalment-due(Elena, Marcus, instalment) && Held(lent) For period * instalment + default-after)
  Creates called-in
Duty everything-due Holder borrower Claimant lender
  Holds when called-in && owing > $0
  Violated when True

Clause 1.1 => lender, borrower, loan, lend, pay
Clause 2.1 Definition => period, fallen-due, interest-owing
Clause 3.1 => regular, instalment-due, pay
Clause 3.2 => covered, instalment-due
Clause 4.1/1 => grace, instalment-due
Clause 4.1/2 Definition => late, fees-owing
Clause 5.1 => owing, pay
Clause 6.1/1 => pay
Clause 6.1/2 => charge-for-early-payment
Clause 6.1/3 => covered, instalment-due
Clause 7.1/1 => default-after, call-in, everything-due
Clause 7.1/2 => call-in.
