// Helen's household: her bank, the electric company, her niece Nora, and a savings account
// that names Helen's estate as its beneficiary.
#require "../poa.charter".
Extend Fact person Identified by Lakeside, Citylight, Nora, Estate.
Extend Fact account Identified by Savings.
+beneficiary(Savings, Estate).

Scenario the-agent-pays-a-bill-and-it-binds-the-principal {
  ?!valid pay(Marcus, Citylight, $120.00).         // not yet signed
  sign().
  ?lawful pay(Marcus, Citylight, $120.00).
  pay(Marcus, Citylight, $120.00).
  ?dealt(Citylight, $120.00).
  ?!valid pay(Nora, Citylight, $99.00).            // Nora is not the agent
  pay(Nora, Citylight, $99.00).
  ?!dealt(Citylight, $99.00).
  transfer(Marcus, Lakeside, $3,000.00).
  ?dealt(Lakeside, $3,000.00).
}

Scenario a-gift-above-five-hundred-dollars-does-not-bind {
  sign().
  ?valid give(Marcus, Nora, $500.00).
  ?!lawful give(Marcus, Nora, $500.01).
  ?!valid give(Marcus, Nora, $500.01).
  give(Marcus, Nora, $500.01).
  ?!dealt(Nora, $500.01).                          // it occurred and changed nothing
}

Scenario the-agent-cannot-change-a-beneficiary {
  sign().
  ?!lawful change-beneficiary(Marcus, Savings, Marcus).
  ?!valid change-beneficiary(Marcus, Savings, Marcus).
  change-beneficiary(Marcus, Savings, Marcus).
  ?beneficiary(Savings, Estate).                   // the attempt changed nothing
  change-beneficiary(Helen, Savings, Nora).        // the principal still can
  ?beneficiary(Savings, Nora). ?!beneficiary(Savings, Estate).
}

Scenario the-power-survives-incapacity {
  sign().
  loses-capacity().
  ?lawful pay(Marcus, Citylight, $120.00).         // durable
  ?valid pay(Marcus, Citylight, $120.00).
  ?!valid revoke(Helen).                           // she cannot revoke without capacity
  revoke(Helen).
  ?authority.
  regains-capacity().
  ?valid revoke(Helen).
}

Scenario after-revocation-only-a-person-without-notice-is-protected {
  sign().
  revoke(Helen).
  ?!authority.
  ?!lawful pay(Marcus, Lakeside, $120.00).         // the agent has no authority now
  ?valid pay(Marcus, Lakeside, $120.00).           // but the bank has no notice
  pay(Marcus, Lakeside, $120.00).
  ?dealt(Lakeside, $120.00).
  give-notice(Helen, Citylight).
  ?!valid pay(Marcus, Citylight, $120.00).
  pay(Marcus, Citylight, $120.00).
  ?!dealt(Citylight, $120.00).
}

Scenario authority-ends-at-death {
  sign().
  ?!lawful give-notice(Nora, Lakeside).            // nothing has ended yet
  death().
  ?!lawful transfer(Marcus, Lakeside, $3,000.00).
  ?valid transfer(Marcus, Lakeside, $3,000.00).    // binds the estate until the bank knows
  give-notice(Nora, Lakeside).
  ?!valid transfer(Marcus, Lakeside, $3,000.00).
  ?!valid revoke(Helen).
}

Scenario the-account-is-due-thirty-days-after-the-request {
  sign().
  pay(Marcus, Citylight, $120.00).
  request-account().
  ?account-due(Marcus, Helen).
  ?!lawful give-account(Marcus, Helen).            // the payment is not yet recorded
  record(Marcus, Citylight, $120.00).
  ?lawful give-account(Marcus, Helen).
  @ 29.
  ?!violated account-due(Marcus, Helen).
  @ 30.
  ?violated account-due(Marcus, Helen).
  give-account(Marcus, Helen).
  ?!account-due(Marcus, Helen).
}
