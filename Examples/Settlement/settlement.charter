// The settlement and mutual release between Elena Voss and Northgate Parking (settlement.md).
Document "settlement.md".

Fact party Identified by Elena, Northgate
Role claimant Is Elena
Role defendant Is Northgate
Fact matter Identified by Incident, AnotherMatter
Param settlement-sum = $18,000.00
Param payment-window : Duration = 14

// 1. The lawsuit, and effect on both signatures
Fact pending Identified by party * party' * matter
Bool in-effect
  Holds when (Forall party: Done(sign(party))) && !Done(rescind(Elena, Northgate))
Act sign Actor party
  Holds when True

// 2. Payment: the whole sum within fourteen days of taking effect
Var paid : USD = $0
Bool paid-in-full
  Holds when paid >= settlement-sum
Bool paid-late
Act pay Actor defendant Recipient claimant Related to amount : USD
  Holds when in-effect
  Creates paid(paid + amount), paid-late When Held(in-effect) For payment-window
Duty payment-due Holder defendant Claimant claimant
  Holds when in-effect && !paid-in-full
  Due within payment-window

// 3. Release: only on full payment; then no released claim is brought, and the lawsuit is dismissed
Bool released
  Holds when in-effect && paid-in-full
Power sue Actor party Recipient party' Related to matter
  Valid when !(released && matter == Incident)
  Creates pending(party, party', matter)
Duty dismissal-due Holder claimant Claimant defendant
  Holds when released && pending(Elena, Northgate, Incident)
  Due within 7 days
Act dismiss-lawsuit Actor claimant Recipient defendant
  Holds when pending(Elena, Northgate, Incident)
  Terminates pending(Elena, Northgate, Incident)

// 4. Late payment: the claimant may rescind, and then returns what was paid
Bool payment-late
  Holds when Violated(payment-due(Northgate, Elena)) || paid-late
Power rescind Actor claimant Recipient defendant
  Valid when payment-late
Duty return-due Holder claimant Claimant defendant
  Holds when Done(rescind(Elena, Northgate)) && paid > $0
Act return-payment Actor claimant Recipient defendant Related to amount : USD
  Holds when Done(rescind(Elena, Northgate))
  Valid when amount == paid
  Creates paid($0)

// 5. Confidentiality
Event legal-demand Related to party
Prohibited disclose-terms Actor party
  Unless Done(legal-demand(party))

// 6. No admission
Fact admission Identified by party
Invariant no-admission When !(Exists party: admission(party))

Clause 1.1 Definition => claimant, defendant, pending(Elena, Northgate, Incident)
Clause 1.2 => sign, in-effect
Clause 2.1 => settlement-sum, payment-window, payment-due, pay
Clause 3.1 => released, pay, sue
Clause 3.2 => sue
Clause 3.3 => dismissal-due, dismiss-lawsuit
Clause 4.1 => payment-late, rescind, sue, return-due, return-payment
Clause 5.1 => legal-demand, disclose-terms
Clause 6.1 Invariant => no-admission.
