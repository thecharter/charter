// A purchase agreement for 14 Alder Lane between Nora Whitfield and Omar Reyes (purchase.md).
Document "purchase.md".

Role seller Is Nora
Role buyer Is Omar
Role escrow-agent Is HarborTitle
Param price = $400,000.00
Param earnest = $10,000.00

// 1. Sale: binding once both have signed; open until closed or cancelled
Act seller-signs Actor seller Holds when True
Act buyer-signs Actor buyer Holds when True
Bool signed Holds when Done(seller-signs(Nora)) && Done(buyer-signs(Omar))
Bool cancelled
Bool open Holds when signed && !cancelled && !closed

// 2. Earnest money: due in three days, held in escrow, paid out only as the agreement says
Bool in-escrow
Bool refundable
Bool forfeited
Duty earnest-due Holder buyer Claimant seller
  Holds when open && !in-escrow
  Due within 3 days
Act pay-earnest Actor buyer Recipient escrow-agent Related to amount : USD
  Holds when open
  Valid when amount == earnest
  Creates in-escrow
Act refund Actor escrow-agent Recipient buyer
  Holds when in-escrow && refundable
  Terminates in-escrow
Act pay-seller Actor escrow-agent Recipient seller
  Holds when in-escrow && (closed || forfeited)
  Terminates in-escrow
Power cancel-for-no-earnest Actor seller Recipient buyer
  Holds when True
  Valid when Violated(earnest-due(Omar, Nora))
  Creates cancelled

// 3. Inspection: ten days
Power cancel-on-inspection Actor buyer Recipient seller
  Holds when True
  Valid when open && !Held(signed) For 10
  Creates cancelled, refundable

// 4. Financing: thirty days
Event lender-commits
Power cancel-on-financing Actor buyer Recipient seller
  Holds when True
  Valid when open && !Done(lender-commits()) && !Held(signed) For 30
  Creates cancelled, refundable

// 5. Closing: the rest of the price and the deed, within forty-five days
Var paid : USD = $0
Duty balance-due Holder buyer Claimant seller
  Holds when open && paid < price - earnest
  Due within 45 days
Act pay-price Actor buyer Recipient seller Related to amount : USD
  Holds when open
  Creates paid(paid + amount)
Duty deed-due Holder seller Claimant buyer
  Holds when open && !Done(deliver-deed(Nora, Omar))
  Due within 45 days
Act deliver-deed Actor seller Recipient buyer
  Holds when open
Bool closed Holds when Done(deliver-deed(Nora, Omar)) && paid >= price - earnest

// 6. Default
Power cancel-for-no-deed Actor buyer Recipient seller
  Holds when True
  Valid when Violated(deed-due(Nora, Omar))
  Creates cancelled, refundable
Power cancel-for-no-payment Actor seller Recipient buyer
  Holds when True
  Valid when Violated(balance-due(Omar, Nora))
  Creates cancelled, forfeited

// 7. Risk of loss
Event house-destroyed
Power cancel-on-loss Actor buyer Recipient seller
  Holds when True
  Valid when open && Done(house-destroyed())
  Creates cancelled, refundable

Clause 1.1 => seller, buyer, price, pay-price, deliver-deed
Clause 1.2/1 => seller-signs, buyer-signs, signed
Clause 1.2/2 Definition => signed
Clause 2.1 => escrow-agent, earnest, earnest-due, pay-earnest
Clause 2.2 => in-escrow, refund, pay-seller
Clause 2.3 => cancel-for-no-earnest
Clause 3.1 => cancel-on-inspection, refundable, refund
Clause 4.1/1 Definition
Clause 4.1/2 => lender-commits, cancel-on-financing
Clause 4.1/3 => cancel-on-financing, refundable, refund
Clause 5.1 => balance-due, deed-due, pay-price, deliver-deed
Clause 5.2 => closed, pay-seller
Clause 6.1 => cancel-for-no-deed, refundable, refund
Clause 6.2 => cancel-for-no-payment, forfeited, pay-seller
Clause 7.1/1 Definition
Clause 7.1/2 => house-destroyed, cancel-on-loss, refundable, refund
Clause 8.1/1 => cancel-for-no-earnest, cancel-on-inspection, cancel-on-financing, cancel-for-no-deed, cancel-for-no-payment, cancel-on-loss
Clause 8.1/2 => cancelled, open, earnest-due, balance-due, deed-due.
