// 14 Alder Lane: both sign on day 0; price $400,000.00, earnest money $10,000.00.
#require "../purchase.charter".

Scenario the-sale-closes {
  seller-signs().
  ?!earnest-due().                                // one signature binds nobody
  buyer-signs().
  ?earnest-due(). ?balance-due(). ?deed-due().
  pay-earnest($10,000.00).
  ?in-escrow. ?!earnest-due().
  ?!lawful pay-seller().                          // not before closing
  @ 40.
  pay-price($200,000.00).
  ?balance-due().                                 // half the balance is not the balance
  pay-price($190,000.00).
  ?!balance-due(). ?!closed.
  deliver-deed().
  ?closed.
  ?lawful pay-seller().
  pay-seller().
  ?!in-escrow.
}

Scenario earnest-money-three-days-late {
  seller-signs(). buyer-signs().
  ?!valid cancel-for-no-earnest().
  @ 2.
  ?!violated earnest-due().
  @ 3.
  ?violated earnest-due().
  ?valid cancel-for-no-earnest().
  cancel-for-no-earnest().
  ?cancelled. ?!balance-due(). ?!deed-due().
}

Scenario half-the-earnest-money-is-not-the-earnest-money {
  seller-signs(). buyer-signs().
  ?!valid pay-earnest($5,000.00).
  pay-earnest($5,000.00).
  ?!in-escrow. ?earnest-due().
}

Scenario the-buyer-walks-away-inside-the-inspection-period {
  seller-signs(). buyer-signs().
  pay-earnest($10,000.00).
  @ 9.
  ?valid cancel-on-inspection().
  cancel-on-inspection().
  ?cancelled. ?!balance-due().
  ?!lawful pay-seller().
  ?lawful refund().
  refund().
  ?!in-escrow.
}

Scenario a-cancellation-on-the-eleventh-day-has-no-effect {
  seller-signs(). buyer-signs().
  pay-earnest($10,000.00).
  lender-commits().
  @ 10.
  ?!valid cancel-on-inspection().
  ?lawful cancel-on-inspection().                 // not a breach to try; it just does nothing
  cancel-on-inspection().
  ?!cancelled. ?balance-due().
  ?!lawful refund().
}

Scenario no-loan-by-the-thirtieth-day {
  seller-signs(). buyer-signs().
  pay-earnest($10,000.00).
  @ 29.
  ?valid cancel-on-financing().
  @ 30.
  ?!valid cancel-on-financing().
}

Scenario a-loan-commitment-ends-the-financing-contingency {
  seller-signs(). buyer-signs().
  pay-earnest($10,000.00).
  @ 15.
  ?valid cancel-on-financing().
  lender-commits().
  ?!valid cancel-on-financing().
}

Scenario the-seller-does-not-deliver-the-deed {
  seller-signs(). buyer-signs().
  pay-earnest($10,000.00).
  @ 44.
  pay-price($390,000.00).
  ?!valid cancel-for-no-deed().
  @ 45.
  ?violated deed-due(). ?!violated balance-due().
  ?!valid cancel-for-no-payment().                // the buyer is not the one in default
  cancel-for-no-deed().
  ?lawful refund().
}

Scenario the-buyer-does-not-pay-and-the-seller-keeps-the-earnest-money {
  seller-signs(). buyer-signs().
  pay-earnest($10,000.00).
  deliver-deed().
  @ 45.
  ?violated balance-due().
  cancel-for-no-payment().
  ?lawful pay-seller().
  ?!lawful refund().
  refund().                                       // the agent pays the wrong party: a breach, and the money is gone
  ?!in-escrow.
}

Scenario the-house-burns-down-before-closing {
  seller-signs(). buyer-signs().
  pay-earnest($10,000.00).
  lender-commits().
  @ 20.
  ?!valid cancel-on-loss().
  house-destroyed().
  ?valid cancel-on-loss().
  cancel-on-loss().
  ?lawful refund().
}

Scenario the-house-burns-down-after-closing {
  seller-signs(). buyer-signs().
  pay-earnest($10,000.00).
  pay-price($390,000.00).
  deliver-deed().
  house-destroyed().
  ?!valid cancel-on-loss().                       // the risk passed with the title
}
