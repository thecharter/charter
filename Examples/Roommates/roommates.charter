// A roommate agreement among Asha Verma, Luis Ortega and Mei Tanaka (roommates.md).
Document "roommates.md".

// M.1 The household
Fact person Identified by Asha, Luis, Mei
Placeholder candidate For person
Placeholder leaver For person
Role landlord Is Grove
Fact roommate Identified by person
Param rent = $2,000.00

// M.2 Rent: shares by floor area; Asha pays the landlord, the others pay Asha
Function room Identified by person * int
Function share Identified by person * amount : USD
  Derived from share(room.person, MulDivRound(rent, room.int, Sum(Foreach room': room'.int), Floor))
Var rent-payer Identified by person
Event month-begins
  Creates (Foreach person: rent-due(person, landlord) When roommate(person))
        , (Foreach person, person': share-due(person, person')
             When roommate(person) && rent-payer(person') && person != person')
Duty share-due Holder person Claimant person'
  Due within 1 day
  Terminated by pay-share
Act pay-share Actor person Recipient person' Related to amount : USD
  Valid when share(person) == amount

// M.3 Joint liability: every roommate owes the landlord the whole rent
Duty rent-due Holder person Claimant landlord
  Due within 1 day
Act pay-rent Actor person Recipient landlord Related to amount : USD
  Holds when rent-due(person, landlord)
  Valid when amount == rent
  Terminates (Foreach person': rent-due(person', landlord))

// M.4 Utilities
Fact bill
Duty utility-due Holder person Claimant person' Related to bill, amount : USD
  Due within 14 days
  Terminated by pay-utility
Act show-bill Actor roommate Related to bill, amount : USD
  Holds when True
  Creates (Foreach person': utility-due(person', roommate, bill, MulDivRound(amount, 1, 3, Floor))
             When roommate(person') && person' != roommate)
Act pay-utility Actor person Recipient person' Related to bill, amount : USD

// M.5 Leaving
Fact leaving Identified by person
Fact moved-out Identified by person
Act give-notice Actor roommate
  Holds when True
  Creates leaving(roommate)
Act move-out Actor person
  Holds when Held(leaving(person)) For 30
  Creates moved-out(person)
Fact approved Identified by person * candidate
Act approve Actor roommate Related to candidate
  Holds when True
  Creates approved(roommate, candidate)
Power take-place Actor candidate Related to leaver
  Holds when True
  Valid when leaving(leaver) && !roommate(candidate)
    && (Forall roommate Except leaver: approved(roommate, candidate))
  Creates roommate(candidate)
        , (Foreach room: room(candidate, room.int) When room.person == leaver)
        , rent-payer(candidate) When rent-payer(leaver)
  Terminates roommate(leaver), leaving(leaver)
           , (Foreach room: room When room.person == leaver)

// M.6 Quiet hours
Bool quiet-hours
Event night-falls Creates quiet-hours
Event morning-comes Terminates quiet-hours
Prohibited make-noise Actor person
  When quiet-hours

// M.7 Guests
Fact guest
Fact staying Identified by guest * person
Fact consented Identified by person * guest
Act host Actor roommate Related to guest
  Holds when True
  Creates guest, staying(guest, roommate)
Act see-off Actor person Related to guest
  Holds when staying(guest, person)
  Terminates staying(guest, person)
Act consent-to-stay Actor roommate Related to guest
  Holds when True
  Creates consented(roommate, guest)
Duty guest-leaves Holder person Claimant person' Related to guest
  Holds when staying(guest, person) && roommate(person') && person' != person
    && !consented(person', guest)
  Due within 4 days

Clause M.1 Definition => landlord, roommate(Asha), roommate(Luis), roommate(Mei)
Clause M.2/1 => rent, pay-rent
Clause M.2/2 => share, room(Asha, 14), room(Luis, 12), room(Mei, 10)
Clause M.2/3 => share
Clause M.2/4 => month-begins, rent-due, pay-rent, share-due, pay-share, rent-payer(Asha)
Clause M.3 => rent-due, pay-rent
Clause M.4 => show-bill, utility-due, pay-utility
Clause M.5/1 => give-notice, move-out
Clause M.5/2 => approve, take-place
Clause M.5/3 => take-place
Clause M.6/1 Definition => quiet-hours, night-falls, morning-comes
Clause M.6/2 => make-noise
Clause M.7/1 => host, see-off, guest-leaves
Clause M.7/2 => consent-to-stay, guest-leaves.
